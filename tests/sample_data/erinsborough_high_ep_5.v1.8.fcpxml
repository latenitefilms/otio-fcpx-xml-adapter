                                <text>
                                    <text-style ref="ts36">Where are you? xx</text-style>
                                </text>
                                <text>
                                    <text-style ref="ts37">～Name</text-style>
                                </text>
                                <text>
                                    <text-style ref="ts38"> 🔐 ENCRYPT</text-style>
                                </text>
