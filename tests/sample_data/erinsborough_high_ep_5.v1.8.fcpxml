                            <keyword start="53680s" duration="147s" value=" sc 13"/>
                            <keyword start="1343204/25s" duration="16800/2500s" value="142 how’d your make-up exam go?"/>
                            <keyword start="1343372/25s" duration="2000/2500s" value="143 it went."/>
                            <keyword start="1343392/25s" duration="5500/2500s" value="144 liv, i know you’re angry with me..."/>
                            <keyword start="1343447/25s" duration="3700/2500s" value="145 mum’s waiting, so no."/>
                            <keyword start="1343467/25s" duration="3700/2500s" value="146 come on, liv, please?"/>
                            <keyword start="1343504/25s" duration="9400/2500s" value="147 what are you still doing here anyway?"/>
                            <keyword start="268718/5s" duration="11800/2500s" value="148 look, maybe i got it wrong with you..."/>
                            <keyword start="1343708/25s" duration="9300/2500s" value="149 i can't promise... i can listen"/>
                            <keyword start="1343801/25s" duration="11800/2500s" value="149a i will help you through"/>
                            <keyword start="1343919/25s" duration="6200/2500s" value="150 i can’t talk about it."/>
                            <keyword start="1343981/25s" duration="15400/2500s" value="151 then write it down..."/>
                            <keyword start="268822/5s" duration="41400/2500s" value="152 phone message"/>
                            <keyword start="1344524/25s" duration="7900/2500s" value="153 i don’t get it."/>
                            <keyword start="1344603/25s" duration="9000/2500s" value="154 it’s the password to my messaging app."/>
                            <keyword start="268936/5s" duration="18400/2500s" value="155 i’ve also made a few of those video diaries..."/>
                            <keyword start="1344864/25s" duration="16500/2500s" value="156 you’ll probably want to call my mum afterwards"/>
                            <keyword start="1345029/25s" duration="11300/2500s" value="157 do you want me to?"/>
                            <keyword start="1345134/25s" duration="15700/2500s" value="158 no... but you should"/>
                            <keyword start="1345291/25s" duration="32200/2500s" value="159 olivia walks out"/>
                        </mc-clip>
