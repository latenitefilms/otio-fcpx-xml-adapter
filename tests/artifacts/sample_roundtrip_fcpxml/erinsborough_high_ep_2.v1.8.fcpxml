                                    <ref-clip name="Incoming iMessage" lane="-1" offset="726321/25s" ref="r173" duration="19280/48000s"/>
                                    <keyword duration="439900/2500s" start="722951/25s" value=" sc 5"/>
                                    <keyword duration="14600/2500s" start="723754/25s" value="103 i’ve been impressed by the effort you’ve shown to lift your grades lately. you’re tracking well heading into year twelve."/>
                                    <keyword duration="2700/2500s" start="28956s" value="104 tell my dad that."/>
                                    <keyword duration="4100/2500s" start="723927/25s" value="105 i did."/>
                                    <keyword duration="3900/2500s" start="28958s" value="106 this catches ritchie off guard."/>
                                    <keyword duration="7200/2500s" start="723968/25s" value="107 he checks in with your teachers, to make sure you’re focused."/>
                                    <keyword duration="6000/2500s" start="144808/5s" value="109 sorry about that"/>
                                    <keyword duration="8500/2500s" start="28964s" value="110 i know what it’s like to manage parents and their expectations."/>
                                    <keyword duration="4000/2500s" start="144837/5s" value="111 my dad’s not the only one who gives you grief?"/>
                                    <keyword duration="8400/2500s" start="28969s" value="112 i was referring to my own. "/>
                                    <keyword duration="9900/2500s" start="144864/5s" value="113 (rueful) when i was your age... we did not see eye to eye. it’s hard when you can’t fully be yourself at home."/>
                                    <keyword duration="13100/2500s" start="145019/5s" value="103 i’ve been impressed by the effort you’ve shown to lift your grades lately. you’re tracking well heading into year twelve."/>
                                    <keyword duration="11900/2500s" start="725473/25s" value="103 i’ve been impressed by the effort you’ve shown to lift your grades lately. you’re tracking well heading into year twelve."/>
                                    <keyword duration="5600/2500s" start="725592/25s" value="104 tell my dad that."/>
                                    <keyword duration="3300/2500s" start="725648/25s" value="105 i did."/>
                                    <keyword duration="3500/2500s" start="725668/25s" value="106 this catches ritchie off guard."/>
                                    <keyword duration="10200/2500s" start="725683/25s" value="107 he checks in with your teachers, to make sure you’re focused."/>
                                    <keyword duration="2800/2500s" start="145157/5s" value="109 sorry about that"/>
                                    <keyword duration="8700/2500s" start="725807/25s" value="110 i know what it’s like to manage parents and their expectations."/>
                                    <keyword duration="5800/2500s" start="725894/25s" value="111 my dad’s not the only one who gives you grief?"/>
                                    <keyword duration="6400/2500s" start="725952/25s" value="112 i was referring to my own. "/>
                                    <keyword duration="21700/2500s" start="726016/25s" value="113 (rueful) when i was your age... we did not see eye to eye. it’s hard when you can’t fully be yourself at home."/>
                                    <keyword duration="8400/2500s" start="726248/25s" value="114 it’s not that bad."/>
                                    <keyword duration="3900/2500s" start="726301/25s" value="115 cherie studies him, unconvinced"/>
                                    <keyword duration="20300/2500s" start="726319/25s" value="116 ritchie’s phone buzzes with texts from mackenzie."/>
                                    <keyword duration="10400/2500s" start="726522/25s" value="117 i really should get back to cramming."/>
                                    <keyword duration="6600/2500s" start="726626/25s" value="118 don’t suppose any of those are from olivia?"/>
                                    <keyword duration="5500/2500s" start="726691/25s" value="119 i heard you guys were close for a while."/>
                                    <keyword duration="4700/2500s" start="726738/25s" value="120 no. sorry."/>
                                    <keyword duration="4800/2500s" start="145357/5s" value="121 do you still talk?"/>
                                    <keyword duration="12800/2500s" start="726833/25s" value="122 sometimes. (awkward) i shouldn’t though. when i talk to girls, it doesn’t end well."/>
                                    <keyword duration="4100/2500s" start="726961/25s" value="123 what does that mean?"/>
                                    <keyword duration="6400/2500s" start="726994/25s" value="124 nothing. i got to go."/>
                                    <keyword duration="1600/2500s" start="727058/25s" value="125 deleted"/>
                                    <keyword duration="6200/2500s" start="727066/25s" value="126 thanks. hey... ritchie--"/>
                                    <keyword duration="11300/2500s" start="727118/25s" value="127 cherie look with concern."/>
                                </mc-clip>
