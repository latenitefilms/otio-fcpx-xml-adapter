                                    <keyword duration="12800/2500s" start="849958/25s" value="0707 look at that - a haunted locker - it’s opened all by itself."/>
                                    <keyword duration="4300/2500s" start="850086/25s" value="0708 slam locker"/>
                                    <keyword duration="7700/2500s" start="850116/25s" value="0709 almost caught myself a ghost there boys."/>
                                    <keyword duration="14500/2500s" start="850193/25s" value="0710 reckon i should put that in my video diary, huh? gonna to be a ghost hunter when i grow up."/>
                                    <keyword duration="1300/2500s" start="850329/25s" value="0711 jeremiah tries to move himself away."/>
                                    <keyword duration="5600/2500s" start="850342/25s" value="0712 whoa, what’s the hurry?"/>
                                    <keyword duration="3500/2500s" start="850398/25s" value="0713 study."/>
                                    <keyword duration="21300/2500s" start="850433/25s" value="0715 we got all next year to look forward to. i’ll be doing some haunting of my own."/>
                                    <keyword duration="3000/2500s" start="850636/25s" value="0716 jeremiah move"/>
                                    <keyword duration="1300/2500s" start="850659/25s" value="0717 boo!"/>
