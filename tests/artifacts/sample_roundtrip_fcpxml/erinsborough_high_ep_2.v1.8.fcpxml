                                    <keyword duration="9400/2500s" start="1401301/25s" value="068 she arrives at the restaurant, which i have a coupon for by the way, "/>
                                    <keyword duration="6200/2500s" start="280279/5s" value="069 she sees me. nek minit - she gone! "/>
                                    <keyword duration="5800/2500s" start="1401457/25s" value="071 that’s enough, hendrix. get up."/>
                                    <keyword duration="8100/2500s" start="280303/5s" value="073 what do you call this?"/>
                                    <keyword duration="8000/2500s" start="1401596/25s" value="074 security, mr muggleton. "/>
                                    <keyword duration="10300/2500s" start="1401676/25s" value="075 i was stopping anyone from taking a look and getting an unfair advantage. you’re welcome."/>
                                    <keyword duration="4000/2500s" start="1401779/25s" value="077 get out."/>
                                    <keyword duration="3000/2500s" start="1401819/25s" value="078 great movie. you seen it?"/>
                                    <keyword duration="4800/2500s" start="1401849/25s" value="079 i mean it, hendrix. leave."/>
                                    <keyword duration="4100/2500s" start="1401897/25s" value="080 hendrix turns on him, not budging. a stand-off."/>
                                    <keyword duration="7700/2500s" start="1401938/25s" value="081 you know, you better hope your dad is happy to bank roll this act of yours forever, "/>
                                    <keyword duration="10900/2500s" start="1402006/25s" value="082  because being a spoilt brat is all you’ve got."/>
                                    <keyword duration="9100/2500s" start="1402083/25s" value="084 totally humiliated, hendrix is scarily still."/>
                                    <keyword duration="7100/2500s" start="1402174/25s" value="085 jeremiah, can you hand these practice exams out please? let’s get started."/>
                                    <keyword duration="4500/2500s" start="280449/5s" value="088 i thought i told you to go."/>
                                    <keyword duration="22000/2500s" start="280458/5s" value="089 he walks out"/>
                                    <keyword duration="3600/2500s" start="280502/5s" value="090 the loud bang makes jeremiah jolt."/>
                                    <keyword duration="11300/2500s" start="1402546/25s" value="092 oh no, the ghost got a fright! thought it was supposed to be the other way round. "/>
