                                    <keyword duration="10700/2500s" start="849474/25s" value="0701 i’ve got almost everyone on board. give me another hour and we’ll be set."/>
                                    <keyword duration="150200/2500s" start="849474/25s" value=" sc 7"/>
                                    <keyword duration="5600/2500s" start="849581/25s" value="0702 dude, i bet the girls came along easy."/>
                                    <keyword duration="8000/2500s" start="849637/25s" value="0703 you know it. all they need is a cheeky compliment."/>
                                    <keyword duration="5300/2500s" start="849717/25s" value="0704 the razz master right here."/>
                                    <keyword duration="5500/2500s" start="169954/5s" value="0705 ease up."/>
