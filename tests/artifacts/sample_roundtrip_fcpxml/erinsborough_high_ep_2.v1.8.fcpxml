                                        <text>
                                            
                                    
                                            <text-style ref="ts35">Please come back. We can
still be together. Trust me. ❤️</text-style>
                                            
                                
                                        </text>
                                        
                                
                                        <text/>
                                        
                                
                                        <text>
                                            
                                    
                                            <text-style ref="ts36">🔐 ENCRYPT</text-style>
                                            
                                
                                        </text>
                                        
                                
                                        <text>
                                            
                                    
                                            <text-style ref="ts37">NOW</text-style>
                                            
                                
