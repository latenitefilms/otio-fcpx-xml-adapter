                                    <keyword duration="402700/2500s" start="62907s" value=" sc 6"/>
                                    <keyword duration="3700/2500s" start="1574428/25s" value="141 i’m just going to... bye."/>
                                    <keyword duration="3500/2500s" start="314893/5s" value="143 was that finn?"/>
                                    <keyword duration="7200/2500s" start="62980s" value="144 yeah..."/>
                                    <keyword duration="7800/2500s" start="1574572/25s" value="145 so weird how he just drops by like he’s a friend of the fam."/>
                                    <keyword duration="6s" start="62986s" value="148 god mum, can you just chill?"/>
                                    <keyword duration="14400/2500s" start="62992s" value="150 i figured you’d be more upset about finn being at the door."/>
                                    <keyword duration="11700/2500s" start="1574944/25s" value="151 guess i’m a bit overwhelmed. (re: her phone) mum on the warpath and all."/>
                                    <keyword duration="8800/2500s" start="1575046/25s" value="152 is there something else going on?"/>
                                    <keyword duration="5700/2500s" start="1575121/25s" value="153 i might grab that shower..."/>
                                    <keyword duration="9700/2500s" start="1575178/25s" value="154 there’s a towel in there for you."/>
                                    <keyword duration="121400/2500s" start="1575261/25s" value="155 yashvi stares at the phone,"/>
                                </mc-clip>
