                                        </text>
                                        
                                
                                        <text>
                                            
                                    
                                            <text-style ref="ts26">I have no idea about Physics but I can 
keep you GROUNDED 🚀 🔭</text-style>
                                            
                                
                                        </text>
                                        
                                
                                        <text-style-def id="ts25">
                                            
                                    
                                            <text-style font="Helvetica Neue" fontSize="31" fontFace="Light" fontColor="0.999996 1 1 1"/>
                                            
                                
