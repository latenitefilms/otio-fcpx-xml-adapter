                        <mc-clip duration="202/25s" name="2-10-1-2 💚" offset="4322s" ref="r231" srcEnable="video" start="1471421/25s" lane="3">
                            <mc-source angleID="angle2_557436" srcEnable="video"/>
                            <keyword duration="18100/2500s" start="1471416/25s" value="10a - ritchie studying"/>
                            <keyword duration="212800/2500s" start="1471416/25s" value="- scene 10"/>
                            <keyword duration="20100/2500s" start="1471597/25s" value="10a1 - you look like someone who needs more time to study."/>
                            <keyword duration="2600/2500s" start="1471798/25s" value="10b - does that mean you got the ghost?"/>
                            <keyword duration="11100/2500s" start="1471824/25s" value="10c - just a matter of time.... mission mugger"/>
                            <keyword duration="4800/2500s" start="1471934/25s" value="10d - are you sure we’ll get to re-sit?"/>
                            <keyword duration="6500/2500s" start="1471982/25s" value="10e - mate, would i ever lead you astray?"/>
                            <keyword duration="11600/2500s" start="1472046/25s" value="10f - this is serious... my dad won't be happy."/>
                            <keyword duration="24700/2500s" start="1472161/25s" value="10g - have some faith.... clock's ticking..."/>
                            <keyword duration="9600/2500s" start="1472312/25s" value="10h - hendrix crosses with an entering mackenzie"/>
                            <keyword duration="5100/2500s" start="1472387/25s" value="10i - mackenzie says &quot;hey&quot;"/>
                            <keyword duration="3300/2500s" start="1472437/25s" value="10j - ritchie says &quot;hi&quot;"/>
                            <keyword duration="2700/2500s" start="1472469/25s" value="10k - mackenzie says &quot;studying?&quot;"/>
                            <keyword duration="3300/2500s" start="1472488/25s" value="10l - ritchie says &quot;yeah&quot;"/>
                            <keyword duration="4200/2500s" start="294504/5s" value="10m - i don’t want to interrupt..."/>
                            <keyword duration="10500/2500s" start="1472552/25s" value="10n - oh, no. i mean, you’re not... did offer to help..."/>
                            <keyword duration="12200/2500s" start="1472656/25s" value="10o - not that i can..."/>
                            <keyword duration="17200/2500s" start="1472777/25s" value="10p - is hendrix still on that ridiculous plan to tank your physics exam?"/>
                            <keyword duration="14400/2500s" start="1472948/25s" value="10q - well, a week’s more study would really help."/>
                            <keyword duration="4500/2500s" start="1473091/25s" value="10r - have you agreed to join in?"/>
                            <keyword duration="7000/2500s" start="294627/5s" value="10s - no. not yet, anyway."/>
                            <keyword duration="4600/2500s" start="294641/5s" value="10t - wow. okay."/>
                            <keyword duration="10400/2500s" start="58930s" value="10u - it’s just stressful. with liv missing..."/>
                            <keyword duration="12200/2500s" start="1473348/25s" value="10v - got it... don't worry about it..."/>
                            <keyword duration="10300/2500s" start="1473441/25s" value="10w - ritchie is left deeply conflicted"/>
                        </mc-clip>
