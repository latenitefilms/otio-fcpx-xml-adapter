                                <mc-clip duration="237/25s" name="3-6-1-3 💚" offset="6712043/48000s" ref="r157" srcEnable="video" start="43452s">
                                    <note>A: off mic line</note>
                                    <mc-source angleID="angle1_876955" srcEnable="video"/>
                                    <keyword duration="304600/2500s" start="43404s" value=" sc 6"/>
                                    <keyword duration="5s" start="217238/5s" value="074 yashvi knocks on the office door "/>
                                    <keyword duration="7400/2500s" start="217262/5s" value="075 hey, have you seen mrs. kennedy anywhere?"/>
                                    <keyword duration="12900/2500s" start="1086379/25s" value="076 he’s off school grounds dealing with an urgent matter. what do you need?"/>
                                    <keyword duration="13900/2500s" start="1086506/25s" value="077 nothing... it’s about olivia."/>
                                    <keyword duration="25600/2500s" start="217328/5s" value="079 when mrs. kennedy is unavailable, you know i’m your next port of call. whatever you need to tell her..."/>
                                    <keyword duration="8300/2500s" start="1086886/25s" value="080 i don’t want to make a big deal of it."/>
                                    <keyword duration="11200/2500s" start="1086968/25s" value="081 olivia may have called to say she’s okay, but she’s obviously still going through a difficult time."/>
                                    <keyword duration="7000/2500s" start="1087079/25s" value="082  any information you have could help us help her. "/>
                                    <keyword duration="6100/2500s" start="1087148/25s" value="083 i think she might be in some kind of trouble. "/>
                                    <keyword duration="4700/2500s" start="1087197/25s" value="084 what kind of trouble?"/>
                                    <keyword duration="13300/2500s" start="217447/5s" value="085 i found out she’s been seeing someone she shouldn’t be, "/>
                                    <keyword duration="8000/2500s" start="1087354/25s" value="086 like secretly. i think they’re older."/>
                                    <keyword duration="3700/2500s" start="217486/5s" value="087 okay..."/>
                                    <keyword duration="8500/2500s" start="1087462/25s" value="088 i saw her get into a car. (beat) it was mr muggleton’s."/>
                                    <keyword duration="11900/2500s" start="217509/5s" value="089 i’m not saying they’re definitely hooking up - but with everything she’s told me... i’m freaking out."/>
                                    <keyword duration="14400/2500s" start="1087651/25s" value="090 you’ve done the right thing. if something inappropriate is going on, the school needs to know"/>
                                    <keyword duration="12900/2500s" start="1087776/25s" value="091 don’t worry, i’ll take care of it"/>
                                    <keyword duration="14700/2500s" start="1087902/25s" value="092 yashvi nods, troubled"/>
                                </mc-clip>
