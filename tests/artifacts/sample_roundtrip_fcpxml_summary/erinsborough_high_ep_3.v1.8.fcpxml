                                    <keyword duration="312700/2500s" start="59798s" value=" sc 9"/>
                                    <keyword duration="40900/2500s" start="1495326/25s" value=" sc 9"/>
                                    <keyword duration="3500/2500s" start="1495739/25s" value="186 freshly showered olivia emerges."/>
                                    <keyword duration="10200/2500s" start="1495774/25s" value="187 now i feel way more human. maybe even ready to do my history exam this arvo."/>
                                    <keyword duration="3700/2500s" start="1495876/25s" value="188 are you sure?"/>
                                    <keyword duration="7100/2500s" start="1495913/25s" value="189 it’ll get mum to calm down. slightly."/>
                                    <keyword duration="4400/2500s" start="1495984/25s" value="190 thanks for the lend."/>
                                    <keyword duration="4100/2500s" start="1496028/25s" value="191 happy to get rid of them."/>
                                    <keyword duration="10400/2500s" start="1496069/25s" value="192 always kind of liked not having to pick an outfit every morning. i’ll miss that."/>
                                    <keyword duration="17200/2500s" start="1496173/25s" value="194 scored so many dirty looks when he was with me in uniform. some people didn’t like the age gap."/>
                                    <keyword duration="5500/2500s" start="299269/5s" value="195 that sucks."/>
                                    <keyword duration="12700/2500s" start="59856s" value="196 are you... hooking up with anyone at the moment?"/>
                                    <keyword duration="10200/2500s" start="1496527/25s" value="197 olivia regards her warily, then realises when she sees the messages"/>
                                    <keyword duration="4000/2500s" start="1496622/25s" value="198 did you read my messages?"/>
                                    <keyword duration="7900/2500s" start="1496662/25s" value="199 no. (then) just, like, the new ones. by accident. i didn’t want to."/>
                                    <keyword duration="5100/2500s" start="1496741/25s" value="200 sure, you just happened to bring up your ‘age gap’ then?"/>
                                    <keyword duration="7900/2500s" start="1496792/25s" value="201 well yeah, i was talking about me and ned. what are you talking about?"/>
                                    <keyword duration="3300/2500s" start="1496871/25s" value="202 nothing."/>
                                    <keyword duration="4600/2500s" start="1496904/25s" value="203 liv, all i’m trying to do is help. breakups are hard, if you want to talk"/>
                                    <keyword duration="4300/2500s" start="59878s" value="204 i haven’t broken up with anyone."/>
                                    <keyword duration="17600/2500s" start="1496993/25s" value="205 so what happened that made you hide away in a storeroom for a whole night? did you have a fight with them?"/>
                                    <keyword duration="9100/2500s" start="1497156/25s" value="206 i can’t--"/>
                                    <keyword duration="8500/2500s" start="1497247/25s" value="207 are you and ritchie back on? ‘cause mackenzie thought he was weird"/>
                                    <keyword duration="4300/2500s" start="1497318/25s" value="208 no"/>
                                    <keyword duration="3400/2500s" start="1497361/25s" value="209 then who?"/>
                                    <keyword duration="8000/2500s" start="299479/5s" value="210 someone i shouldn’t be with. someone i can’t talk about."/>
                                    <keyword duration="4700/2500s" start="59899s" value="212 olivia longs to unload her burden. but she can’t."/>
                                    <keyword duration="2800/2500s" start="1497522/25s" value="213 liv-- liv, come on."/>
                                    <keyword duration="4000/2500s" start="59902s" value="214 i can’t."/>
                                    <keyword duration="2900/2500s" start="299518/5s" value="215 liv..."/>
                                    <keyword duration="17200/2500s" start="1497619/25s" value="216 but she’s fled the house."/>
                                    <keyword duration="8600/2500s" start="299558/5s" value=" sc 9"/>
