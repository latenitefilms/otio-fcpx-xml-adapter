                            <keyword duration="188700/2500s" start="1292326/25s" value=" sc 12"/>
                            <keyword duration="23600/2500s" start="1292413/25s" value="218 hendrix moves along the corridor. jeremiah studying alone inside"/>
                            <keyword duration="3s" start="1292649/25s" value="219 yo. ghost."/>
                            <keyword duration="6000/2500s" start="1292724/25s" value="220 jeremiah tries to play it cool. i heard about what you did."/>
                            <keyword duration="9000/2500s" start="1292784/25s" value="221 to ollie. you didn’t give him the message."/>
                            <keyword duration="15900/2500s" start="1292874/25s" value="222 didn’t tell his mates either, right? they’re going to hate getting screwed over."/>
                            <keyword duration="12400/2500s" start="1293023/25s" value="223 they deserve it. (dry) guys like that have such a bright future. "/>
                            <keyword duration="12000/2500s" start="1293147/25s" value="224 i mean, we’re talking the leaders of tomorrow here. they need to understand hardship."/>
                            <keyword duration="11400/2500s" start="1293273/25s" value="225 you’re funny. no one mentioned that. "/>
                            <keyword duration="6200/2500s" start="1293387/25s" value="226 guess they don’t take notice"/>
                            <keyword duration="13900/2500s" start="1293449/25s" value="227 they will after tonight. i won five-k at this cup comp and i’m going to chuck some of it on a party at lassiters. room 302."/>
                            <keyword duration="10600/2500s" start="1293592/25s" value="228 it’s going to be a banger. see you there?"/>
                            <keyword duration="7800/2500s" start="1293698/25s" value="229 sure? if you want me to come..."/>
                            <keyword duration="5700/2500s" start="1293776/25s" value="230 i’ll save you some shots. "/>
                            <keyword duration="9300/2500s" start="258766/5s" value="231 wait. what should i wear?"/>
                        </mc-clip>
