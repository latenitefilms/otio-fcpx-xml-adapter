                                    <keyword duration="13600/2500s" start="1451751/25s" value="006 mrs. kennedy’s gonna rip him a new one when we all get big fat zeros."/>
                                    <keyword duration="6800/2500s" start="1451887/25s" value="007 ritchie’s phone buzzes with a text."/>
                                    <keyword duration="8500/2500s" start="290391/5s" value="008 ritchie turns to hendrix,"/>
                                    <keyword duration="5700/2500s" start="290408/5s" value="009 i’m out."/>
                                    <keyword duration="3000/2500s" start="1452097/25s" value="010 huh?"/>
                                    <keyword duration="2800/2500s" start="1452127/25s" value="011 the tank. i’m not doing it."/>
                                    <keyword duration="2s" start="1452162/25s" value="012 you can’t pull out now. "/>
                                    <keyword duration="4400/2500s" start="1452211/25s" value="013 it’s not going to work if everyone’s not in."/>
                                    <keyword duration="4000/2500s" start="290451/5s" value="014 not my problem."/>
                                    <keyword duration="12100/2500s" start="290459/5s" value="016 well then - thanks to you - guess i’m going to have to call it off."/>
                                    <keyword duration="12000/2500s" start="1452416/25s" value="018 sorry i’m late. you’ll get extra time at the end to compensate."/>
                                    <keyword duration="7300/2500s" start="1452536/25s" value="019 everything off your desks except pens, pencils and erasers."/>
                                    <keyword duration="6300/2500s" start="1452609/25s" value="020 panicking, hendrix"/>
                                    <keyword duration="2600/2500s" start="1452672/25s" value="021 tank’s off."/>
