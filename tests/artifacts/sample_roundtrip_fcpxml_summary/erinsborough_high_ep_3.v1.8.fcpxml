                        <mc-clip duration="333/25s" name="3-10-1-2" offset="41657200/10000s" ref="r218" srcEnable="video" start="774052/25s" lane="1">
                            <mc-source angleID="angle1_809381" srcEnable="video"/>
                            <keyword duration="272400/2500s" start="30937s" value=" sc 10"/>
                            <keyword duration="227000/2500s" start="773788/25s" value=" sc 10"/>
                            <keyword duration="6200/2500s" start="774034/25s" value="131 you admit you gave olivia a lift"/>
                            <keyword duration="6900/2500s" start="774096/25s" value="132 i didn’t want her to be late. she had an exam."/>
                            <keyword duration="8400/2500s" start="154833/5s" value="133 you left school in the middle of the day. what were you even doing there?"/>
                            <keyword duration="16400/2500s" start="774249/25s" value="134 my meals were getting delivered for the week. i told them i wouldn’t be home during the day but they turned up anyway."/>
                            <keyword duration="9100/2500s" start="774413/25s" value="135 those boxes don’t keep them as cool as everyone thinks."/>
                            <keyword duration="6300/2500s" start="774504/25s" value="136 then you just happened to see olivia?"/>
                            <keyword duration="3200/2500s" start="774567/25s" value="137 yes"/>
                            <keyword duration="6300/2500s" start="774599/25s" value="138 what happened after you picked her up"/>
                            <keyword duration="8000/2500s" start="774662/25s" value="139 what do you mean? i drove her to school"/>
                            <keyword duration="9600/2500s" start="774734/25s" value="140 i heard you were late for your own class. "/>
                            <keyword duration="8200/2500s" start="154966/5s" value="141 she didn’t know where her exam was being held. i had to help her"/>
                            <keyword duration="8000/2500s" start="774912/25s" value="142 if you’re trying to imply i acted inappropriately."/>
                            <keyword duration="5100/2500s" start="774984/25s" value="143 you did act inappropriately."/>
                            <keyword duration="10700/2500s" start="155006/5s" value="144 you invited a troubled young student into your car, without parental knowledge or consent."/>
                            <keyword duration="6200/2500s" start="775137/25s" value="145 sure, maybe "/>
                            <keyword duration="6100/2500s" start="155037/5s" value="147 in the car? what did you talk about?"/>
                            <keyword duration="10300/2500s" start="775228/25s" value="146 what did you talk about?"/>
                            <keyword duration="8800/2500s" start="775331/25s" value="148 i don’t know. i had a podcast on. something about the hadron collider."/>
                            <keyword duration="8700/2500s" start="775408/25s" value="149 are you going to tell susan about this? "/>
                            <keyword duration="14900/2500s" start="775483/25s" value="150 yashvi’s already wondering if there’s a relationship. "/>
                            <keyword duration="16400/2500s" start="775608/25s" value="151 you’d seriously think she and i would."/>
                            <keyword duration="21900/2500s" start="775731/25s" value="152 i would never. i swear. "/>
                            <keyword duration="10700/2500s" start="775918/25s" value="153 cherie studies marty"/>
                        </mc-clip>
