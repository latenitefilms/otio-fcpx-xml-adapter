                            <keyword duration="32000/2500s" start="167151/5s" value="291 &quot;when you called off the tank...&quot;"/>
                            <keyword duration="15900/2500s" start="33443s" value="292 &quot;i don’t know. i guess i kinda hated the idea.&quot;"/>
