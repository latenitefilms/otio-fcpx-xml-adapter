                            <keyword duration="432400/2500s" start="31726s" value=" sc 10"/>
                            <keyword duration="357900/2500s" start="793689/25s" value=" sc 10"/>
                            <keyword duration="8600/2500s" start="794129/25s" value="131 you admit you gave olivia a lift"/>
                            <keyword duration="6600/2500s" start="158843/5s" value="132 i didn’t want her to be late. she had an exam."/>
                            <keyword duration="11000/2500s" start="794281/25s" value="133 you left school in the middle of the day. what were you even doing there?"/>
                            <keyword duration="7200/2500s" start="159027/5s" value="131 you admit you gave olivia a lift"/>
                            <keyword duration="7600/2500s" start="795207/25s" value="132 i didn’t want her to be late. she had an exam."/>
                            <keyword duration="9800/2500s" start="795283/25s" value="133 you left school in the middle of the day. what were you even doing there?"/>
                            <keyword duration="16400/2500s" start="795381/25s" value="134 my meals were getting delivered for the week. i told them i wouldn’t be home during the day but they turned up anyway."/>
                            <keyword duration="7900/2500s" start="159109/5s" value="135 those boxes don’t keep them as cool as everyone thinks."/>
                            <keyword duration="7400/2500s" start="795624/25s" value="136 then you just happened to see olivia?"/>
                            <keyword duration="3400/2500s" start="795687/25s" value="137 yes"/>
                            <keyword duration="6900/2500s" start="795721/25s" value="138 what happened after you picked her up"/>
                            <keyword duration="8500/2500s" start="159158/5s" value="139 what do you mean? i drove her to school"/>
                            <keyword duration="6300/2500s" start="31835s" value="140 i heard you were late for your own class. "/>
                            <keyword duration="10100/2500s" start="795929/25s" value="141 she didn’t know where her exam was being held. i had to help her"/>
                            <keyword duration="7300/2500s" start="159206/5s" value="142 if you’re trying to imply i acted inappropriately."/>
                            <keyword duration="14700/2500s" start="796103/25s" value="144 you invited a troubled young student into your car, without parental knowledge or consent."/>
                            <keyword duration="8400/2500s" start="796232/25s" value="145 sure, maybe "/>
                            <keyword duration="7400/2500s" start="796316/25s" value="146 what did you talk about?"/>
                            <keyword duration="7600/2500s" start="159278/5s" value="147 in the car? what did you talk about?"/>
                            <keyword duration="7000/2500s" start="796466/25s" value="148 i don’t know. i had a podcast on. something about the hadron collider."/>
                            <keyword duration="5600/2500s" start="796536/25s" value="149 are you going to tell susan about this? "/>
                            <keyword duration="8600/2500s" start="796592/25s" value="150 yashvi’s already wondering if there’s a relationship. "/>
                            <keyword duration="20400/2500s" start="796678/25s" value="151 you’d seriously think she and i would."/>
                            <keyword duration="24300/2500s" start="796819/25s" value="152 i would never. i swear. "/>
                            <keyword duration="8200/2500s" start="797032/25s" value="153 cherie studies marty"/>
                        </mc-clip>
