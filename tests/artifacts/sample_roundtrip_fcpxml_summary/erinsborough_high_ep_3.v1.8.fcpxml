                                <text>
                                    
                                    
                                    <text-style ref="ts37">Mackenzie</text-style>
                                    
                                
                                </text>
                                
                                
                                <text>
                                    
                                    
                                    <text-style ref="ts38">Do you want to kiss me?</text-style>
                                    
                                
                                </text>
                                
                                
