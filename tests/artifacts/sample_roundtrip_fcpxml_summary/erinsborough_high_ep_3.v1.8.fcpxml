                                    <mc-source angleID="angle2_965083" srcEnable="video"/>
                                    <keyword duration="290300/2500s" start="64338s" value=" sc 3"/>
                                    <keyword duration="3500/2500s" start="1609573/25s" value="037 a distracted yashvi opens the door"/>
                                    <keyword duration="8700/2500s" start="1609608/25s" value="038 hey, i’m on my way to a foundation meeting. toadie wanted me to pick up a folder?"/>
                                    <keyword duration="5400/2500s" start="1609688/25s" value="039 the one on the table?"/>
                                    <keyword duration="8500/2500s" start="1609742/25s" value="040 must be it."/>
                                    <keyword duration="13100/2500s" start="1609827/25s" value="042 i hear olivia turned up, or rang at least"/>
                                    <keyword duration="9100/2500s" start="1609958/25s" value="043 yeah. actually, she was here, earlier. when you came over"/>
                                    <keyword duration="7300/2500s" start="1610049/25s" value="044 is she okay?"/>
                                    <keyword duration="17200/2500s" start="1610122/25s" value="045 yeah-- no. i’m not sure, but you should know, i don’t think you were the reason she did a runner"/>
                                    <keyword duration="9900/2500s" start="1610294/25s" value="046 i shouldn’t have been at the school anyway."/>
                                    <keyword duration="2600/2500s" start="1610393/25s" value="048 wait"/>
                                    <keyword duration="14400/2500s" start="1610419/25s" value="049 you still remember uni, don’t you? when you were studying teaching?"/>
                                    <keyword duration="9500/2500s" start="1610563/25s" value="051 is it ever okay for a student to catch a lift with a teacher?"/>
                                    <keyword duration="9000/2500s" start="1610658/25s" value="052 the department of education has pretty strict rules on that sort of thing"/>
                                    <keyword duration="10700/2500s" start="1610748/25s" value="053 i know i did bad things, so it feels weird to judge. "/>
                                    <keyword duration="11100/2500s" start="322171/5s" value="054 but a teacher shouldn’t blur the lines like that. ever."/>
                                    <keyword duration="5500/2500s" start="1610966/25s" value="055 did you see something?"/>
                                    <keyword duration="2900/2500s" start="1611021/25s" value="056 i didn’t say that."/>
                                    <keyword duration="16400/2500s" start="1611044/25s" value="057 if you did - i think you need to tell susan."/>
                                    <keyword duration="9800/2500s" start="322222/5s" value="058 on a torn yashvi"/>
                                </mc-clip>
