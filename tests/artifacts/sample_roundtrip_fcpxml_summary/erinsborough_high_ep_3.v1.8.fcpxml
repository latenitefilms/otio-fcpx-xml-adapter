                            <keyword duration="26000/2500s" start="838127/25s" value="289 &quot;you sure you don’t want to go back inside?&quot;"/>
                            <keyword duration="335100/2500s" start="838127/25s" value=" sc 18"/>
                            <keyword duration="16300/2500s" start="838387/25s" value="290 &quot;it’s getting kind of messy in there&quot;"/>
                            <keyword duration="24000/2500s" start="33542s" value="291 &quot;when you called off the tank...&quot;"/>
                            <keyword duration="36300/2500s" start="167758/5s" value="292 &quot;i don’t know. i guess i kinda hated the idea.&quot;"/>
                            <keyword duration="11300/2500s" start="839153/25s" value="294 why didn’t you say that before?"/>
                            <keyword duration="26200/2500s" start="839233/25s" value="295 &quot;i can’t work you out. sometimes it’s like you...&quot;"/>
                            <keyword duration="18600/2500s" start="167899/5s" value="296 &quot;anything you want to know, just ask&quot;"/>
                            <keyword duration="16300/2500s" start="839609/25s" value="297 &quot;...something going on with you &amp; liv?&quot;"/>
                            <keyword duration="10800/2500s" start="839756/25s" value="298 &quot;no. why would you say that?&quot;"/>
                            <keyword duration="6000/2500s" start="839864/25s" value="299 &quot;you act weird when she comes up&quot;"/>
