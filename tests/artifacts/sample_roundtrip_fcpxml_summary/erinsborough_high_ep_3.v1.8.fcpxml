                            <keyword duration="7400/2500s" start="923971/25s" value="250 alright, i s’pose."/>
                            <keyword duration="5800/2500s" start="184809/5s" value="251 it’s good liv showed up."/>
                            <keyword duration="7300/2500s" start="924103/25s" value="257 hendrix, who’s jumped up on the bed"/>
                            <keyword duration="15300/2500s" start="924176/25s" value="258 party’s on me tonight mofo’s."/>
                            <keyword duration="7400/2500s" start="924512/25s" value="258 party’s on me tonight mofo’s."/>
                            <keyword duration="19000/2500s" start="924586/25s" value="259 is he ever off?...not that i’ve seen."/>
                            <keyword duration="4800/2500s" start="924731/25s" value="259 is he ever off?...not that i’ve seen."/>
                            <keyword duration="10800/2500s" start="924779/25s" value="260 on hendrix, man of the hour"/>
