                            <keyword duration="322400/2500s" start="31486s" value=" sc 10"/>
                            <keyword duration="264600/2500s" start="31505s" value=" sc 10"/>
                            <keyword duration="6700/2500s" start="157632/5s" value="131 you admit you gave olivia a lift"/>
                            <keyword duration="7000/2500s" start="788227/25s" value="132 i didn’t want her to be late. she had an exam."/>
                            <keyword duration="9400/2500s" start="788297/25s" value="133 you left school in the middle of the day. what were you even doing there?"/>
                            <keyword duration="19200/2500s" start="788391/25s" value="134 my meals were getting delivered for the week. i told them i wouldn’t be home during the day but they turned up anyway."/>
                            <keyword duration="9400/2500s" start="788583/25s" value="135 those boxes don’t keep them as cool as everyone thinks."/>
                            <keyword duration="5400/2500s" start="788677/25s" value="136 then you just happened to see olivia?"/>
                            <keyword duration="2800/2500s" start="788731/25s" value="137 yes"/>
                            <keyword duration="6600/2500s" start="788748/25s" value="138 what happened after you picked her up"/>
                            <keyword duration="8600/2500s" start="788814/25s" value="139 what do you mean? i drove her to school"/>
                            <keyword duration="5300/2500s" start="31556s" value="141 she didn’t know where her exam was being held. i had to help her"/>
                            <keyword duration="9900/2500s" start="788944/25s" value="141 she didn’t know where her exam was being held. i had to help her"/>
                            <keyword duration="7000/2500s" start="789034/25s" value="142 if you’re trying to imply i acted inappropriately."/>
                            <keyword duration="2s" start="789104/25s" value="143 you did act inappropriately."/>
                            <keyword duration="10700/2500s" start="789154/25s" value="144 you invited a troubled young student into your car, without parental knowledge or consent."/>
                            <keyword duration="7300/2500s" start="789261/25s" value="145 sure, maybe "/>
                            <keyword duration="6200/2500s" start="789322/25s" value="146 what did you talk about?"/>
                            <keyword duration="11000/2500s" start="789356/25s" value="147 in the car? what did you talk about?"/>
                            <keyword duration="8300/2500s" start="789454/25s" value="148 i don’t know. i had a podcast on. something about the hadron collider."/>
                            <keyword duration="9300/2500s" start="789537/25s" value="149 are you going to tell susan about this? "/>
                            <keyword duration="12000/2500s" start="789631/25s" value="150 yashvi’s already wondering if there’s a relationship. "/>
                            <keyword duration="15200/2500s" start="157943/5s" value="151 you’d seriously think she and i would."/>
                            <keyword duration="17400/2500s" start="789841/25s" value="152 i would never. i swear. "/>
                            <keyword duration="22300/2500s" start="790003/25s" value="153 cherie studies marty"/>
                        </mc-clip>
