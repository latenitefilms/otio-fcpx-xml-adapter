                                    <keyword duration="9200/2500s" start="1600013/25s" value="043 ritchie "/>
                                    <keyword duration="17600/2500s" start="320021/5s" value="044 just a little update for those keeping score - ollie’s a yes, so everyone’s in for operation mug shot."/>
                                    <keyword duration="5500/2500s" start="1600281/25s" value="045 are you really calling it that?"/>
                                    <keyword duration="4200/2500s" start="1600336/25s" value="046 trying out options."/>
                                    <keyword duration="7700/2500s" start="1600378/25s" value="047 and everyone? seriously?"/>
                                    <keyword duration="13800/2500s" start="320091/5s" value="048 technically there’s two to go. you and-"/>
                                    <keyword duration="5500/2500s" start="1600593/25s" value="049 the ghost"/>
                                    <keyword duration="22700/2500s" start="1600648/25s" value="050 good luck"/>
                                    <keyword duration="12100/2500s" start="320173/5s" value="051 ah ghost"/>
                                    <keyword duration="7300/2500s" start="1601763/25s" value="051 ah ghost"/>
                                    <keyword duration="7900/2500s" start="1601827/25s" value="054 you want me to flunk my exam."/>
                                    <keyword duration="8200/2500s" start="1602309/25s" value="051 ah ghost"/>
                                    <keyword duration="5900/2500s" start="1602391/25s" value="054 you want me to flunk my exam."/>
                                    <keyword duration="4800/2500s" start="64098s" value="055 heard you were quick on the uptake."/>
                                    <keyword duration="3300/2500s" start="1602497/25s" value="057 why would i want to do that?"/>
                                    <keyword duration="5600/2500s" start="320506/5s" value="058 they’ll build a statue of me by the front gate."/>
                                    <keyword duration="3400/2500s" start="1602586/25s" value="066 so it’s all about you."/>
                                    <keyword duration="8700/2500s" start="320524/5s" value="067 dude, i am vibing this energy between us."/>
                                    <keyword duration="6800/2500s" start="1602707/25s" value="068 it’s like i’m peter parker, you’re miles."/>
                                    <keyword duration="7400/2500s" start="1602768/25s" value="069 really? a comic book reference to help sway the nerd?"/>
                                    <keyword duration="9800/2500s" start="1602833/25s" value="070 just say you’ll think about it."/>
                                    <keyword duration="6800/2500s" start="1602931/25s" value="072 that sounds like a maybe."/>
                                    <keyword duration="7600/2500s" start="1602999/25s" value="074 i’ll take it. thank you, oh ghost who walks."/>
                                    <keyword duration="4900/2500s" start="64123s" value="075 do you even know what you’re accidentally quoting?"/>
                                    <keyword duration="3000/2500s" start="1603124/25s" value="076 phantom."/>
                                    <keyword duration="6500/2500s" start="1603158/25s" value="077 you’re not the only comic book fan in this school."/>
                                    <keyword duration="5600/2500s" start="1603223/25s" value="078  i just make it look good."/>
                                    <keyword duration="15700/2500s" start="1603279/25s" value="079 jeremiah allows himself a small smile, having enjoyed the brief experience of friendly warmth."/>
                                </mc-clip>
