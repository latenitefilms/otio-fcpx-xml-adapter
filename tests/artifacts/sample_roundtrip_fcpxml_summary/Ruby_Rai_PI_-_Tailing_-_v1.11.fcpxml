                                    <param name="Flatten" key="9999/999166631/999166633/2/351" value="1"/>
                                    <param name="Alignment" key="9999/999166631/999166633/2/354/999169573/401" value="1 (Center)"/>
                                    <param name="disableDRT" key="3733" value="1"/>
                                    <text>
                                        
                                    
                                        <text-style ref="ts616">FAVORITE</text-style>
                                        
                                
                                    </text>
                                    <text-style-def id="ts616">
                                        
                                    
                                        <text-style font="Helvetica" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/>
                                        
                                
                                    </text-style-def>
                                </title>
                            </spine>
                        </gap>
                    </spine>
                </sequence>
            </project>
        </event>
        <smart-collection name="Projects" match="all">
            
            
            <match-clip rule="is" type="project"/>
            
        
        </smart-collection>
        <smart-collection name="All Video" match="any">
            
            
            <match-media rule="is" type="videoOnly"/>
            
            
            <match-media rule="is" type="videoWithAudio"/>
            
        
        </smart-collection>
        <smart-collection name="Audio Only" match="all">
            
            
            <match-media rule="is" type="audioOnly"/>
            
        
        </smart-collection>
        <smart-collection name="Stills" match="all">
            
            
            <match-media rule="is" type="stills"/>
            
        
        </smart-collection>
        <smart-collection name="Favorites" match="all">
            
            
            <match-ratings value="favorites"/>
            
        
        </smart-collection>
    </library>
</fcpxml>
