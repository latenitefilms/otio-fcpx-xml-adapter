                                <mc-clip duration="56/25s" name="1-7-1-2 💚" offset="7963296/898319s" ref="r56" start="716647/25s">
                                    <mc-source angleID="angle1_120658" srcEnable="video"/>
                                    <keyword duration="240500/2500s" start="716647/25s" value=" sc 7"/>
                                    <keyword duration="19800/2500s" start="716647/25s" value="07a - walks in and says &quot;hey&quot;"/>
                                    <keyword duration="17900/2500s" start="716844/25s" value="07b - i'm sorry, is this your seat?"/>
                                    <keyword duration="12800/2500s" start="716942/25s" value="07c - &quot;can i ask you a question?&quot;"/>
                                    <keyword duration="3s" start="717062/25s" value="07d - &quot;ah, yep... yes&quot;"/>
                                    <keyword duration="9900/2500s" start="717131/25s" value="07e - &quot;that was meant to be tough... that practise...?&quot;"/>
                                    <keyword duration="10100/2500s" start="717216/25s" value="07f - &quot;um... well...&quot;"/>
                                    <keyword duration="6000/2500s" start="28692s" value="07g - &quot;you found it easy, didn’t you?&quot;"/>
                                    <keyword duration="19900/2500s" start="717359/25s" value="07h - &quot;it's just physics 1, 2... it's 3, 4 that really matters&quot;"/>
                                    <keyword duration="19800/2500s" start="717424/25s" value="07i - 📱text message"/>
                                    <keyword duration="15800/2500s" start="717573/25s" value="07j - &quot;you look like someone took a dump...&quot;"/>
                                    <keyword duration="20300/2500s" start="717704/25s" value="07k - &quot;i’m screwed man... calls in a bomb threat&quot;"/>
                                    <keyword duration="12800/2500s" start="717884/25s" value="07l - &quot;what if i told you, you had nothing to...&quot;"/>
                                    <keyword duration="8700/2500s" start="717988/25s" value="07m - &quot;i was joking about the bomb threat&quot;"/>
                                    <keyword duration="9100/2500s" start="718074/25s" value="07n - &quot;no... you agree muggleton’s a flog, yeah?&quot;"/>
                                    <keyword duration="6200/2500s" start="718164/25s" value="07o - &quot;i guess, yeah&quot;"/>
                                    <keyword duration="17200/2500s" start="718222/25s" value="07p - &quot;so let’s screw him. steal a copy...&quot;"/>
                                    <keyword duration="10500/2500s" start="718376/25s" value="07q - &quot;no way. we get caught, my dad kills me.&quot;"/>
                                    <keyword duration="5300/2500s" start="718479/25s" value="07r - &quot;so we don’t get caught.&quot;"/>
                                    <keyword duration="7300/2500s" start="718524/25s" value="07s - &quot;if you pass it'll look suss&quot;"/>
                                    <keyword duration="11300/2500s" start="143717/5s" value="07t - &quot;thanks for the vote of confidence...&quot;"/>
                                    <keyword duration="15300/2500s" start="718688/25s" value="07u - &quot;come on, man. what are you going to do?&quot;"/>
                                    <keyword duration="22400/2500s" start="718828/25s" value="07v - end scene"/>
