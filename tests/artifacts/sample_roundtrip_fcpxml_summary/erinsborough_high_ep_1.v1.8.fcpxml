                                    <note>A: wide - tighter on hendrix/ marty</note>
                                    <mc-source angleID="angle2_4169" srcEnable="video">
                                        
                                
                                        <adjust-transform position="0 -6.41667"/>
                                        
                            
                                    </mc-source>
                                    <keyword duration="623300/2500s" start="55422s" value=" sc 3"/>
                                    <keyword duration="14300/2500s" start="1388792/25s" value="059 ritchie, eyes on his phone, enters the chaos"/>
                                    <keyword duration="3100/2500s" start="277781/5s" value="060 ritchie walks straight into jeremiah. "/>
                                    <keyword duration="5100/2500s" start="1388936/25s" value="061 sorry man. didn’t see you."/>
                                    <keyword duration="6000/2500s" start="1388987/25s" value="062 that’s cool. no-one does."/>
                                    <keyword duration="4800/2500s" start="1389047/25s" value="063 no response from ritchie as he finds a seat."/>
                                    <keyword duration="9400/2500s" start="1389084/25s" value="065 forget everything i’ve taught you this year, my padawans. "/>
                                    <keyword duration="15100/2500s" start="1389178/25s" value="066 the best way to actually measure the speed of light is by how fast my tinder dates want to leave. "/>
                                    <keyword duration="11900/2500s" start="1389329/25s" value="068 she arrives at the restaurant, which i have a coupon for by the way, "/>
                                    <keyword duration="9900/2500s" start="1389448/25s" value="069 she sees me. nek minit - she gone! "/>
                                    <keyword duration="6100/2500s" start="1389547/25s" value="071 that’s enough, hendrix. get up."/>
                                    <keyword duration="3900/2500s" start="1389608/25s" value="073 what do you call this?"/>
                                    <keyword duration="5700/2500s" start="1389647/25s" value="074 security, mr muggleton. "/>
                                    <keyword duration="8300/2500s" start="1389704/25s" value="075 i was stopping anyone from taking a look and getting an unfair advantage. you’re welcome."/>
                                    <keyword duration="2800/2500s" start="1389787/25s" value="077 get out."/>
                                    <keyword duration="4200/2500s" start="1389817/25s" value="078 great movie. you seen it?"/>
                                    <keyword duration="6300/2500s" start="1389859/25s" value="079 i mean it, hendrix. leave."/>
                                    <keyword duration="4800/2500s" start="1389906/25s" value="080 hendrix turns on him, not budging. a stand-off."/>
                                    <keyword duration="8200/2500s" start="1389954/25s" value="081 you know, you better hope your dad is happy to bank roll this act of yours forever, "/>
                                    <keyword duration="5900/2500s" start="1390036/25s" value="082  because being a spoilt brat is all you’ve got."/>
                                    <keyword duration="8500/2500s" start="278019/5s" value="084 totally humiliated, hendrix is scarily still."/>
                                    <keyword duration="11000/2500s" start="278036/5s" value="085 jeremiah, can you hand these practice exams out please? let’s get started."/>
                                    <keyword duration="3800/2500s" start="278058/5s" value="088 i thought i told you to go."/>
                                    <keyword duration="22800/2500s" start="1390328/25s" value="089 he walks out"/>
                                    <keyword duration="3800/2500s" start="1390556/25s" value="090 the loud bang makes jeremiah jolt."/>
                                    <keyword duration="10700/2500s" start="1390594/25s" value="092 oh no, the ghost got a fright! thought it was supposed to be the other way round. "/>
                                    <keyword duration="26600/2500s" start="1390701/25s" value="093 jeremiah doesn’t respond, quietly continues on with his assigned task. "/>
                                </mc-clip>
