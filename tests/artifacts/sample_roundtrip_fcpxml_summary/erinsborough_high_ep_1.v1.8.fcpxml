                                    <keyword duration="22400/2500s" start="1399844/25s" value="093 jeremiah doesn’t respond, quietly continues on with his assigned task. "/>
                                    <keyword duration="11300/2500s" start="1399957/25s" value="092 oh no, the ghost got a fright! thought it was supposed to be the other way round. "/>
                                    <keyword duration="3600/2500s" start="1399993/25s" value="090 the loud bang makes jeremiah jolt."/>
                                    <keyword duration="22000/2500s" start="1400213/25s" value="089 he walks out"/>
                                    <keyword duration="4500/2500s" start="1400258/25s" value="088 i thought i told you to go."/>
                                    <keyword duration="7100/2500s" start="1400329/25s" value="085 jeremiah, can you hand these practice exams out please? let’s get started."/>
                                    <keyword duration="9100/2500s" start="280084/5s" value="084 totally humiliated, hendrix is scarily still."/>
                                    <keyword duration="10900/2500s" start="1400497/25s" value="082  because being a spoilt brat is all you’ve got."/>
                                    <keyword duration="7700/2500s" start="280113/5s" value="081 you know, you better hope your dad is happy to bank roll this act of yours forever, "/>
                                    <keyword duration="4100/2500s" start="1400606/25s" value="080 hendrix turns on him, not budging. a stand-off."/>
                                    <keyword duration="4800/2500s" start="1400654/25s" value="079 i mean it, hendrix. leave."/>
                                    <keyword duration="3000/2500s" start="1400684/25s" value="078 great movie. you seen it?"/>
                                    <keyword duration="4000/2500s" start="1400724/25s" value="077 get out."/>
                                    <keyword duration="10300/2500s" start="1400827/25s" value="075 i was stopping anyone from taking a look and getting an unfair advantage. you’re welcome."/>
                                    <keyword duration="8000/2500s" start="1400907/25s" value="074 security, mr muggleton. "/>
                                    <keyword duration="8100/2500s" start="1400988/25s" value="073 what do you call this?"/>
                                    <keyword duration="5800/2500s" start="1401046/25s" value="071 that’s enough, hendrix. get up."/>
                                    <keyword duration="6200/2500s" start="1401108/25s" value="069 she sees me. nek minit - she gone! "/>
                                    <keyword duration="9400/2500s" start="1401202/25s" value="068 she arrives at the restaurant, which i have a coupon for by the way, "/>
                                    <keyword duration="7000/2500s" start="1401236/25s" value="067 the n/s students love it. hendrix is in his element."/>
                                    <keyword duration="13000/2500s" start="1401348/25s" value="066 the best way to actually measure the speed of light is by how fast my tinder dates want to leave. "/>
                                    <keyword duration="7900/2500s" start="1401427/25s" value="065 forget everything i’ve taught you this year, my padawans. "/>
                                    <keyword duration="14000/2500s" start="1401896/25s" value="067 the n/s students love it. hendrix is in his element."/>
                                    <keyword duration="11500/2500s" start="1401996/25s" value="066 the best way to actually measure the speed of light is by how fast my tinder dates want to leave. "/>
                                    <keyword duration="8000/2500s" start="1402076/25s" value="065 forget everything i’ve taught you this year, my padawans. "/>
