                                    <keyword duration="538600/2500s" start="818558/25s" value=" sc 8"/>
                                    <keyword duration="3700/2500s" start="819958/25s" value="159 cherie finishes up a phone call to susan"/>
                                    <keyword duration="4200/2500s" start="163998/5s" value="160 a knock at the door, it’s jeremiah."/>
                                    <keyword duration="9700/2500s" start="32801s" value="161 she gestures for him to come in and take a seat. "/>
                                    <keyword duration="4s" start="820102/25s" value="162 i can only imagine what angela’s going through. "/>
                                    <keyword duration="13000/2500s" start="164041/5s" value="163 thanks susan. let us know if you hear anything more."/>
                                    <keyword duration="3000/2500s" start="820324/25s" value="164 marty bursts through the door"/>
                                    <keyword duration="8900/2500s" start="820343/25s" value="165  hendrix greyson is the definition of a petulant child."/>
                                    <keyword duration="6700/2500s" start="821331/25s" value="163 thanks susan. let us know if you hear anything more."/>
                                    <keyword duration="3500/2500s" start="821384/25s" value="164 marty bursts through the door"/>
                                    <keyword duration="7400/2500s" start="821413/25s" value="165  hendrix greyson is the definition of a petulant child."/>
                                    <keyword duration="1900/2500s" start="821482/25s" value="169 marty--"/>
                                    <keyword duration="7300/2500s" start="32860s" value="170 and jesus christ, would it kill these people to give me some real food to eat?"/>
                                    <keyword duration="4500/2500s" start="821566/25s" value="171 registers cherie indicating jeremiah’s presence."/>
                                    <keyword duration="7000/2500s" start="32864s" value="172 mate, i’m sorry. i didn’t know "/>
                                    <keyword duration="7200/2500s" start="821666/25s" value="173 that’s cool. teenagers are the worst."/>
                                    <keyword duration="7100/2500s" start="821733/25s" value="174 how about we have your careers catch up when things are less hectic, jeremiah? if you don’t mind?"/>
                                    <keyword duration="5300/2500s" start="32872s" value="175 no worries, miss."/>
                                    <keyword duration="10500/2500s" start="821848/25s" value="176 cherie ushers him out and closes the door behind him"/>
                                    <keyword duration="8400/2500s" start="821946/25s" value="177 sorry. i had no idea he was here"/>
                                    <keyword duration="2s" start="822032/25s" value="178 you’re lucky it was only jeremiah"/>
                                    <keyword duration="10100/2500s" start="822082/25s" value="179 and why are you letting yourself get baited by hendrix? you know he tries this on with all of us."/>
                                    <keyword duration="7800/2500s" start="822179/25s" value="180 he just pushes my buttons, cherie. every time."/>
                                    <keyword duration="4300/2500s" start="32890s" value="182 did you retaliate?"/>
                                    <keyword duration="3200/2500s" start="822298/25s" value="183 marty looks guilty"/>
                                    <keyword duration="2000/2500s" start="822333/25s" value="184 marty..."/>
                                    <keyword duration="8600/2500s" start="822353/25s" value="185 i know, it was stupid. but i didn’t say anything that wasn’t true. "/>
                                    <keyword duration="3800/2500s" start="822442/25s" value="186 you have to apologise"/>
                                    <keyword duration="4000/2500s" start="822474/25s" value="187 he started it."/>
                                    <keyword duration="12600/2500s" start="822512/25s" value="188 a teenage girl is missing. i think we should be doing everything we can to make the students feel safe. "/>
                                    <keyword duration="8800/2500s" start="822638/25s" value="189 despite the effect it might have on our ego. "/>
                                    <keyword duration="18900/2500s" start="32909s" value="190 marty takes the advice on, but he’s not looking forward to it."/>
                                    <keyword duration="7800/2500s" start="823256/25s" value="189 despite the effect it might have on our ego. "/>
                                    <keyword duration="12300/2500s" start="823483/25s" value="188 a teenage girl is missing. i think we should be doing everything we can to make the students feel safe. "/>
