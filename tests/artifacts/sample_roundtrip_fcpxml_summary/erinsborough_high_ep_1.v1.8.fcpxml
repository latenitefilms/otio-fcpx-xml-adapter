                                    <keyword duration="12400/2500s" start="305417/5s" value="010 yes, boo hoo, this is me, sympathetic, feeling your pain - can i get a high five already?"/>
                                    <keyword duration="3900/2500s" start="1527209/25s" value="011 with a wry smile, mackenzie obliges."/>
                                    <keyword duration="2900/2500s" start="1527248/25s" value="012 well done. time to enjoy the joys of adulthood."/>
                                    <keyword duration="13600/2500s" start="1527281/25s" value="013 working, paying taxes, voting, university..."/>
                                    <keyword duration="8300/2500s" start="1527417/25s" value="014 yashvi shifts slightly at the mention of uni. gee mackenzie, way to bring down the vibe. let me enjoy the moment a little."/>
                                    <keyword duration="7900/2500s" start="1527497/25s" value="018 enjoy the summer, you know, leave the adulting for next year."/>
                                    <keyword duration="145200/2500s" start="1528467/25s" value=" sc2"/>
                                    <keyword duration="14000/2500s" start="1528467/25s" value="018 enjoy the summer, you know, leave the adulting for next year."/>
