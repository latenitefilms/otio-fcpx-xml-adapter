                                <mc-clip audioDuration="4156416/720000s" audioStart="150051600/2500s" duration="144/25s" name="1-2-1-1" offset="25077/1250s" ref="r125" start="1500516/25s">
                                    <note>A: 2 x 3/s mackenzie/yashvi/harlow</note>
