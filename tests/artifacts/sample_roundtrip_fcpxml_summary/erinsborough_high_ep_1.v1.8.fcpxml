                                    <keyword duration="11400/2500s" start="303322/5s" value="003 yashvi emerges"/>
                                    <keyword duration="245400/2500s" start="303322/5s" value=" sc2"/>
                                    <keyword duration="6700/2500s" start="1516724/25s" value="004 that is it, all over."/>
                                    <keyword duration="9500/2500s" start="1516791/25s" value="005 i am finally free."/>
                                    <keyword duration="9200/2500s" start="1516886/25s" value="009 no need to rub it in. some of us still have exams left. or a whole other year of school."/>
                                    <keyword duration="11900/2500s" start="1516978/25s" value="010 yes, boo hoo, this is me, sympathetic, feeling your pain - can i get a high five already?"/>
                                    <keyword duration="5300/2500s" start="1517097/25s" value="012 well done. time to enjoy the joys of adulthood."/>
                                    <keyword duration="15400/2500s" start="60686s" value="013 working, paying taxes, voting, university..."/>
                                    <keyword duration="8000/2500s" start="1517296/25s" value="014 yashvi shifts slightly at the mention of uni. gee mackenzie, way to bring down the vibe. let me enjoy the moment a little."/>
                                    <keyword duration="10900/2500s" start="1517367/25s" value="018 enjoy the summer, you know, leave the adulting for next year."/>
                                    <keyword duration="3100/2500s" start="1517476/25s" value="021 (distracted) ya-huh."/>
                                    <keyword duration="20700/2500s" start="303501/5s" value="023 but my plan is basically, get rich on a game show, spend it on a face and neck tattoo."/>
                                    <keyword duration="16800/2500s" start="1517712/25s" value="024 then live out an angry, bitter existence towards all mankind ‘cause i could never get a job."/>
                                    <keyword duration="3900/2500s" start="1517841/25s" value="025 solid life plan, don’t you think?"/>
                                    <keyword duration="6100/2500s" start="303576/5s" value="028 sounds like you’ve got it all figured out."/>
                                    <keyword duration="3700/2500s" start="1517941/25s" value="029 okay, who are you sexting?"/>
                                    <keyword duration="3900/2500s" start="1517978/25s" value="033 no-one."/>
                                    <keyword duration="8800/2500s" start="1518017/25s" value="034 that’s a seriously juicy emoji cocktail."/>
                                    <keyword duration="4200/2500s" start="303621/5s" value="035 is that code for something?"/>
                                    <keyword duration="7700/2500s" start="303626/5s" value="036 mackenzie’s shock sets in as she snatches the phone back, accidentally pressing send at the same time."/>
                                    <keyword duration="3800/2500s" start="1518207/25s" value="037 i didn’t mean to send that."/>
                                    <keyword duration="4300/2500s" start="303649/5s" value="040 it better not be hendrix."/>
                                    <keyword duration="2700/2500s" start="1518288/25s" value="041 i bet it’s ritchie."/>
                                    <keyword duration="3200/2500s" start="303663/5s" value="042 a mild improvement. "/>
                                    <keyword duration="3100/2500s" start="1518347/25s" value="043 i’m not sexting. "/>
                                    <keyword duration="5200/2500s" start="1518378/25s" value="044 loud enough to be heard by nearby n/s students, further embarrasses her. "/>
                                    <keyword duration="8400/2500s" start="303686/5s" value="046 you don’t know where olivia went, do you?"/>
                                    <keyword duration="11100/2500s" start="1518514/25s" value="047 in case you can’t tell from - (pointing to her face) - this excitement, i’ve been busy, doing my last exam ever."/>
                                    <keyword duration="9900/2500s" start="60745s" value="048 yes, the business exam that liv was meant to be in too. didn’t you notice she wasn’t there?"/>
                                    <keyword duration="9900/2500s" start="1518724/25s" value="050 all the teachers have been asking if anyone’s heard from her"/>
                                    <keyword duration="4900/2500s" start="1518823/25s" value="049 oh yeah, i didn’t see her. that’s weird."/>
                                    <keyword duration="4200/2500s" start="1518872/25s" value="051 apparently she’s missing."/>
                                    <keyword duration="8300/2500s" start="1518914/25s" value="052 like, missing missing?"/>
                                    <keyword duration="6700/2500s" start="1518997/25s" value="055 come on, it’s been what? a couple of hours? "/>
                                    <keyword duration="50600/2500s" start="1519091/25s" value=" sc2"/>
                                    <keyword duration="6200/2500s" start="1519091/25s" value="052 like, missing missing?"/>
                                    <keyword duration="11400/2500s" start="1519152/25s" value="055 come on, it’s been what? a couple of hours? "/>
                                    <keyword duration="7200/2500s" start="1519268/25s" value="056 it’s not like her to miss a year twelve exam though."/>
                                    <keyword duration="6600/2500s" start="303868/5s" value="057 love the girl, but we all know liv is a drama queen."/>
                                    <keyword duration="19000/2500s" start="1519407/25s" value="058 she’s probably off living out one of her daydreams somewhere."/>
                                </mc-clip>
