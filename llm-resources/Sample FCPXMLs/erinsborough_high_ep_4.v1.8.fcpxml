                            <keyword start="44437s" duration="410100/2500s" value=" sc 6"/>
                            <keyword start="1111774/25s" duration="6000/2500s" value="080 i don’t want to make a big deal of it."/>
                            <keyword start="1111829/25s" duration="14400/2500s" value="081 olivia may have called to say she’s okay, but she’s obviously still going through a difficult time."/>
                            <keyword start="1111967/25s" duration="8400/2500s" value="082  any information you have could help us help her. "/>
                            <keyword start="222409/5s" duration="8600/2500s" value="083 i think she might be in some kind of trouble. "/>
                            <keyword start="1112123/25s" duration="6800/2500s" value="084 what kind of trouble?"/>
                            <keyword start="1112188/25s" duration="9100/2500s" value="085 i found out she’s been seeing someone she shouldn’t be, "/>
                            <keyword start="222456/5s" duration="6200/2500s" value="086 like secretly. i think they’re older."/>
                            <keyword start="1112331/25s" duration="5400/2500s" value="087 okay..."/>
                            <keyword start="222476/5s" duration="8300/2500s" value="088 i saw her get into a car. (beat) it was mr muggleton’s."/>
                            <keyword start="222492/5s" duration="10500/2500s" value="089 i’m not saying they’re definitely hooking up - but with everything she’s told me... i’m freaking out."/>
                            <keyword start="1112564/25s" duration="14900/2500s" value="090 you’ve done the right thing. if something inappropriate is going on, the school needs to know"/>
                            <keyword start="1112712/25s" duration="8600/2500s" value="091 don’t worry, i’ll take care of it"/>
                            <keyword start="1112792/25s" duration="16000/2500s" value="092 yashvi nods, troubled"/>
                            <keyword start="1113758/25s" duration="13200/2500s" value="090 you’ve done the right thing. if something inappropriate is going on, the school needs to know"/>
                            <keyword start="222776/5s" duration="8500/2500s" value="091 don’t worry, i’ll take care of it"/>
                            <keyword start="1113961/25s" duration="14100/2500s" value="092 yashvi nods, troubled"/>
                            <keyword start="222899/5s" duration="12600/2500s" value="090 you’ve done the right thing. if something inappropriate is going on, the school needs to know"/>
