                            <keyword start="36754s" duration="666100/2500s" value=" sc 15"/>
                            <keyword start="922477/25s" duration="19200/2500s" value="228 guess who i just saw macking on... "/>
                            <keyword start="922654/25s" duration="8700/2500s" value="230 marty. are you okay?"/>
                            <keyword start="922728/25s" duration="6400/2500s" value="231 it’s getting worse."/>
                            <keyword start="922781/25s" duration="6800/2500s" value="232 did you speak to susan?"/>
                            <keyword start="922844/25s" duration="22400/2500s" value="233 she said there’s going to have to an investigation. that just means more gossip."/>
                            <keyword start="923063/25s" duration="10500/2500s" value="235 all this ‘cause of a stupid car ride."/>
                            <keyword start="923174/25s" duration="14300/2500s" value="236 have you thought about leaving?"/>
                            <keyword start="923314/25s" duration="12600/2500s" value="237 i’m not running away. not when i haven’t done the things they’re saying about me."/>
                            <keyword start="923429/25s" duration="13700/2500s" value="238 okay, but say this all ends with no proof anything’s happened between you two."/>
                            <keyword start="923562/25s" duration="2700/2500s" value="239 which it hasn’t."/>
                            <keyword start="923587/25s" duration="18500/2500s" value="240 yes, i know, what i’m trying to say is - is the talk ever going to stop? "/>
                            <keyword start="923758/25s" duration="8000/2500s" value="241 this morning you said it would. "/>
                            <keyword start="923832/25s" duration="8900/2500s" value="242 things seem a little more serious now than they were this morning."/>
                            <keyword start="923916/25s" duration="10800/2500s" value="243 you know what this place is like. the kids, parents. "/>
                            <keyword start="924018/25s" duration="17600/2500s" value="244 once you’ve got that stain on your reputation, it doesn’t come off, whether the story’s true or not."/>
                            <keyword start="924181/25s" duration="7000/2500s" value="245 that isn’t fair."/>
                            <keyword start="924242/25s" duration="10700/2500s" value="246 no, it isn’t."/>
                            <keyword start="924351/25s" duration="17400/2500s" value="247 marty, i’ve sat opposite you for long enough to know this job gets you down sometimes."/>
                            <keyword start="924526/25s" duration="9800/2500s" value="248 it would be hard but"/>
                            <keyword start="924626/25s" duration="7300/2500s" value="249 it could be the best thing that ever happened to you. on marty"/>
                            <keyword start="924626/25s" duration="25700/2500s" value="249 it could be the best thing that ever happened to you. on marty"/>
                        </mc-clip>
