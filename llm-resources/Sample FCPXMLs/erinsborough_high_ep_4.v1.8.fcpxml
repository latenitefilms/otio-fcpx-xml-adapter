                            <keyword start="29483s" duration="264200/2500s" value=" sc 16"/>
                            <keyword start="737631/25s" duration="11900/2500s" value="251 a seated jeremiah"/>
                            <keyword start="29510s" duration="3300/2500s" value="252 hey dude."/>
                            <keyword start="737783/25s" duration="8800/2500s" value="253 you didn’t come to my party last night."/>
                            <keyword start="737871/25s" duration="5500/2500s" value="254 something came up."/>
                            <keyword start="737926/25s" duration="8900/2500s" value="255 something more important than a blinder hosted by yours truly? "/>
                            <keyword start="738003/25s" duration="6000/2500s" value="256 jeremiah’s silence,"/>
                            <keyword start="738063/25s" duration="10400/2500s" value="258 so i need your help, apparently. that’s what muggleton reckons. "/>
                            <keyword start="738167/25s" duration="2s" value="259 you’re listening to what he says now? "/>
                            <keyword start="738217/25s" duration="5200/2500s" value="260 mate. what’s with the sass? "/>
                            <keyword start="738264/25s" duration="16600/2500s" value="262 you can be, if you want to be my physics tutor next year?"/>
                            <keyword start="738414/25s" duration="14500/2500s" value="263 i need your help...dad's loaded"/>
                            <keyword start="738559/25s" duration="4000/2500s" value="264 you should ask someone else."/>
                            <keyword start="738599/25s" duration="3400/2500s" value="265 i’m asking you."/>
                            <keyword start="738633/25s" duration="1900/2500s" value="266 why?"/>
                            <keyword start="738652/25s" duration="5600/2500s" value="267 cause you’re smart. and you’re cool."/>
                            <keyword start="738708/25s" duration="4900/2500s" value="268 yeah. sure."/>
                            <keyword start="738757/25s" duration="17300/2500s" value="269 and you got that fun thing where you get all sarcastic and act like no one would ever want to hang with you."/>
                            <keyword start="738932/25s" duration="12400/2500s" value="271 seriously mate, ease up. you’d be good value if you just let yourself."/>
                            <keyword start="739034/25s" duration="8300/2500s" value="272 jeremiah desperately wants to say connect. "/>
                            <keyword start="147823/5s" duration="6200/2500s" value="273 so that’s a yes?"/>
                            <keyword start="739177/25s" duration="4700/2500s" value="274 okay."/>
                            <keyword start="739224/25s" duration="6200/2500s" value="275 my man...punches him lightly in the gut."/>
                            <keyword start="739286/25s" duration="7000/2500s" value="277 what’s wrong? are you hurt?"/>
                            <keyword start="739356/25s" duration="2700/2500s" value="278 nothing."/>
                            <keyword start="739383/25s" duration="6200/2500s" value="279 what the hell is that"/>
                            <keyword start="147889/5s" duration="4900/2500s" value="284 was it ollie?"/>
                            <keyword start="739494/25s" duration="19400/2500s" value="285 jeremiah’s silent look "/>
                        </mc-clip>
