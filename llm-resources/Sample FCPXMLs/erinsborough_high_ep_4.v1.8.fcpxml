                            <keyword start="852496/25s" duration="10100/2500s" value="099 hendrix knocks on the door. "/>
                            <keyword start="852594/25s" duration="2600/2500s" value="099 hendrix knocks on the door. "/>
                            <keyword start="852617/25s" duration="4200/2500s" value="102 you wanted to see me?"/>
                            <keyword start="852649/25s" duration="11300/2500s" value="103 yes. take a seat. i have your physics exam."/>
                            <keyword start="170553/5s" duration="4600/2500s" value="106 you marked it already?"/>
                            <keyword start="852798/25s" duration="4900/2500s" value="103 yes. take a seat. i have your physics exam."/>
                            <keyword start="852849/25s" duration="8900/2500s" value="108 heard you’ve ‘been doing’ quite a lot lately."/>
                            <keyword start="852937/25s" duration="9200/2500s" value="110 so, you didn’t pass."/>
                            <keyword start="853027/25s" duration="6600/2500s" value="111 guess that must make you pretty happy."/>
                            <keyword start="853094/25s" duration="7400/2500s" value="112 why would it make me happy?"/>
                            <keyword start="853138/25s" duration="4400/2500s" value="113 surprises hendrix"/>
                            <keyword start="34127s" duration="7300/2500s" value="114 are you planning on doing physics next year?"/>
                            <keyword start="34130s" duration="5500/2500s" value="115 i started it, so... "/>
                            <keyword start="853296/25s" duration="10100/2500s" value="116 good. because you have the potential to do well."/>
                            <keyword start="853382/25s" duration="14700/2500s" value="117 ah, so you want to have the ‘potential’ chat. sorry bro, i’m tapping out."/>
                            <keyword start="34141s" duration="18700/2500s" value="119 what little you did, your answers were right. you just weren’t showing your working properly."/>
                            <keyword start="853706/25s" duration="5300/2500s" value="120 hendrix’s not sure what to say."/>
                            <keyword start="853722/25s" duration="9400/2500s" value="121 if you want to go well next year, you could get yourself a tutor, like jeremiah. i’m sure he’d love to buddy up -"/>
                            <keyword start="853814/25s" duration="4500/2500s" value="122 nah nah nah."/>
                            <keyword start="170767/5s" duration="12900/2500s" value="123 he can catch you up on this year, and work with"/>
                            <keyword start="853961/25s" duration="9800/2500s" value="124 why is it having potential equals doing more work? "/>
                            <keyword start="854059/25s" duration="10100/2500s" value="125 because that’s the price of having something to offer the world. "/>
                            <keyword start="854159/25s" duration="8900/2500s" value="126 oh dude, save the corn for your little salad there. "/>
                            <keyword start="854247/25s" duration="6700/2500s" value="127 hendrix, i’m just trying to help. "/>
                            <keyword start="854312/25s" duration="10800/2500s" value="128 this going to end in the same kind of help you give olivia? "/>
                            <keyword start="170883/5s" duration="8400/2500s" value="129 don’t say that. and sit down."/>
                            <keyword start="854479/25s" duration="11000/2500s" value="130 hendrix, satisfied"/>
                            <keyword start="854572/25s" duration="5900/2500s" value="132 think about it, okay? i’d be happy to have you next year, especially if you’re working at the level i know you could be."/>
                            <keyword start="854638/25s" duration="19100/2500s" value="132 think about it, okay? i’d be happy to have you next year, especially if you’re working at the level i know you could be."/>
                            <keyword start="854832/25s" duration="9500/2500s" value="133 you’re capable of smashing it."/>
                            <keyword start="854913/25s" duration="6400/2500s" value="134 hendrix is warmed"/>
                            <keyword start="34199s" duration="4800/2500s" value="135 is that all? "/>
                            <keyword start="855023/25s" duration="7200/2500s" value="136 yes. that’s it."/>
                            <keyword start="171017/5s" duration="5600/2500s" value="136a wait"/>
                            <keyword start="855122/25s" duration="7000/2500s" value="136b take it"/>
                            <keyword start="855183/25s" duration="8300/2500s" value="136c keep it as reminder"/>
                            <keyword start="855287/25s" duration="11400/2500s" value="136c keep it as reminder"/>
