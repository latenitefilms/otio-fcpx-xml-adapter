                            <keyword start="712926/25s" duration="409900/2500s" value=" sc 5"/>
                            <keyword start="714642/25s" duration="13900/2500s" value="103 i’ve been impressed by the effort you’ve shown to lift your grades lately. you’re tracking well heading into year twelve."/>
                            <keyword start="714764/25s" duration="4500/2500s" value="104 tell my dad that."/>
                            <keyword start="715154/25s" duration="13000/2500s" value="103 i’ve been impressed by the effort you’ve shown to lift your grades lately. you’re tracking well heading into year twelve."/>
                            <keyword start="715284/25s" duration="4400/2500s" value="104 tell my dad that."/>
                            <keyword start="715323/25s" duration="3100/2500s" value="105 i did."/>
                            <keyword start="715354/25s" duration="2700/2500s" value="106 this catches ritchie off guard."/>
                            <keyword start="715357/25s" duration="8500/2500s" value="107 he checks in with your teachers, to make sure you’re focused."/>
                            <keyword start="715442/25s" duration="8500/2500s" value="109 sorry about that"/>
                            <keyword start="715516/25s" duration="9100/2500s" value="110 i know what it’s like to manage parents and their expectations."/>
                            <keyword start="715598/25s" duration="5200/2500s" value="111 my dad’s not the only one who gives you grief?"/>
                            <keyword start="28626s" duration="7000/2500s" value="112 i was referring to my own. "/>
                            <keyword start="143144/5s" duration="19600/2500s" value="113 (rueful) when i was your age... we did not see eye to eye. it’s hard when you can’t fully be yourself at home."/>
                            <keyword start="715916/25s" duration="11500/2500s" value="114 it’s not that bad."/>
                            <keyword start="716031/25s" duration="5100/2500s" value="115 cherie studies him, unconvinced"/>
                            <keyword start="716057/25s" duration="22200/2500s" value="116 ritchie’s phone buzzes with texts from mackenzie."/>
                            <keyword start="716279/25s" duration="6300/2500s" value="117 i really should get back to cramming."/>
                            <keyword start="716342/25s" duration="7600/2500s" value="118 don’t suppose any of those are from olivia?"/>
                            <keyword start="716406/25s" duration="6100/2500s" value="119 i heard you guys were close for a while."/>
                            <keyword start="716467/25s" duration="4400/2500s" value="120 no. sorry."/>
                            <keyword start="716511/25s" duration="4100/2500s" value="121 do you still talk?"/>
                            <keyword start="716552/25s" duration="5s" value="122 sometimes. (awkward) i shouldn’t though. when i talk to girls, it doesn’t end well."/>
                            <keyword start="716677/25s" duration="1s" value="123 what does that mean?"/>
                            <keyword start="716702/25s" duration="6300/2500s" value="124 nothing. i got to go."/>
                            <keyword start="143353/5s" duration="7900/2500s" value="126 thanks. hey... ritchie--"/>
                            <keyword start="716844/25s" duration="9300/2500s" value="127 cherie look with concern."/>
                        </mc-clip>
