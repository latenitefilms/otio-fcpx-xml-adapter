                            <keyword start="1448861/25s" duration="7000/2500s" value="002 you’ve been in here? the entire time?"/>
                            <keyword start="1448861/25s" duration="220100/2500s" value=" sc 2"/>
                            <keyword start="1448923/25s" duration="1s" value="005 keep your voice down."/>
                            <keyword start="1448948/25s" duration="8600/2500s" value="006 are you okay? you look okay."/>
                            <keyword start="1449034/25s" duration="2900/2500s" value="007 ... yeah, but--"/>
                            <keyword start="1449063/25s" duration="5200/2500s" value="008 what have you been eating? and drinking?"/>
                            <keyword start="289823/5s" duration="2100/2500s" value="011 overwhelmed, olivia’s eyes begin to well,"/>
                            <keyword start="1449136/25s" duration="7700/2500s" value="012 sorry-- sorry. okay, let’s start with why you’re holed up in here."/>
                            <keyword start="1449213/25s" duration="10200/2500s" value="013 i couldn’t face-- it was too much..."/>
                            <keyword start="289863/5s" duration="6200/2500s" value="014 everyone thinks you full smoke-bomb vanished ‘cause of finn."/>
                            <keyword start="1449377/25s" duration="2800/2500s" value="015 finn?"/>
                            <keyword start="289881/5s" duration="7200/2500s" value="016 yeah, like you saw him and freaked out."/>
                            <keyword start="1449477/25s" duration="6400/2500s" value="017 or did something else happen?"/>
                            <keyword start="1449541/25s" duration="12900/2500s" value="018 no, it was finn. i-- he scared me. he’s like, a total psycho."/>
                            <keyword start="289934/5s" duration="13200/2500s" value="019 sure. but it’s safe now. and everyone’s been looking for you - they’re all really worried."/>
                            <keyword start="1449802/25s" duration="3600/2500s" value="020 i can’t deal with that."/>
                            <keyword start="1449838/25s" duration="1500/2500s" value="021 if you just - (let them know)"/>
                            <keyword start="1449853/25s" duration="2800/2500s" value="022 i can’t."/>
                            <keyword start="1449881/25s" duration="3500/2500s" value="023 i have to get out of here."/>
                            <keyword start="1449916/25s" duration="3700/2500s" value="024 let’s get you home."/>
                            <keyword start="1449953/25s" duration="9100/2500s" value="025 to mum? she’ll be cut i missed that business exam."/>
                            <keyword start="1450044/25s" duration="6400/2500s" value="026 reckon she’ll be pretty distracted by the part where you’re alive and well."/>
                            <keyword start="1450108/25s" duration="8000/2500s" value="027 i step outside and i’ll be hit with a million questions i don’t want to deal with."/>
                            <keyword start="1450188/25s" duration="12900/2500s" value="030 i need your help. can you get me out of here without anyone seeing?"/>
                            <keyword start="1450317/25s" duration="9700/2500s" value="031 i don’t know, the cops are everywhere..."/>
                            <keyword start="1450396/25s" duration="5800/2500s" value="032 olivia’s pleading look."/>
                            <keyword start="1450454/25s" duration="26300/2500s" value="034 this should help."/>
                            <keyword start="1450717/25s" duration="34500/2500s" value="035 yashvi cracks open the door"/>
                            <keyword start="1450717/25s" duration="9000/2500s" value="036 give it a minute to clear out."/>
                        </mc-clip>
