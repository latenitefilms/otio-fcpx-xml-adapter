                            <keyword start="63956s" duration="187s" value=" sc 3"/>
                            <keyword start="1599889/25s" duration="2800/2500s" value="040 welcome aboard."/>
                            <keyword start="1599917/25s" duration="4800/2500s" value="041 always keen to make muggleton cry."/>
                            <keyword start="319993/5s" duration="4800/2500s" value="042 thanks man, you the best."/>
                            <keyword start="1600013/25s" duration="9200/2500s" value="043 ritchie "/>
                            <keyword start="320021/5s" duration="17600/2500s" value="044 just a little update for those keeping score - ollie’s a yes, so everyone’s in for operation mug shot."/>
                            <keyword start="1600281/25s" duration="5500/2500s" value="045 are you really calling it that?"/>
                            <keyword start="1600336/25s" duration="4200/2500s" value="046 trying out options."/>
                            <keyword start="1600378/25s" duration="7700/2500s" value="047 and everyone? seriously?"/>
                            <keyword start="320091/5s" duration="13800/2500s" value="048 technically there’s two to go. you and-"/>
                            <keyword start="1600593/25s" duration="5500/2500s" value="049 the ghost"/>
                            <keyword start="1600648/25s" duration="22700/2500s" value="050 good luck"/>
                            <keyword start="320173/5s" duration="12100/2500s" value="051 ah ghost"/>
                            <keyword start="1601763/25s" duration="7300/2500s" value="051 ah ghost"/>
                            <keyword start="1601827/25s" duration="7900/2500s" value="054 you want me to flunk my exam."/>
                            <keyword start="1602309/25s" duration="8200/2500s" value="051 ah ghost"/>
                            <keyword start="1602391/25s" duration="5900/2500s" value="054 you want me to flunk my exam."/>
                            <keyword start="64098s" duration="4800/2500s" value="055 heard you were quick on the uptake."/>
                            <keyword start="1602497/25s" duration="3300/2500s" value="057 why would i want to do that?"/>
                            <keyword start="320506/5s" duration="5600/2500s" value="058 they’ll build a statue of me by the front gate."/>
                            <keyword start="1602586/25s" duration="3400/2500s" value="066 so it’s all about you."/>
                            <keyword start="320524/5s" duration="8700/2500s" value="067 dude, i am vibing this energy between us."/>
                            <keyword start="1602707/25s" duration="6800/2500s" value="068 it’s like i’m peter parker, you’re miles."/>
                            <keyword start="1602768/25s" duration="7400/2500s" value="069 really? a comic book reference to help sway the nerd?"/>
                            <keyword start="1602833/25s" duration="9800/2500s" value="070 just say you’ll think about it."/>
                            <keyword start="1602931/25s" duration="6800/2500s" value="072 that sounds like a maybe."/>
                            <keyword start="1602999/25s" duration="7600/2500s" value="074 i’ll take it. thank you, oh ghost who walks."/>
                            <keyword start="64123s" duration="4900/2500s" value="075 do you even know what you’re accidentally quoting?"/>
                            <keyword start="1603124/25s" duration="3000/2500s" value="076 phantom."/>
                            <keyword start="1603158/25s" duration="6500/2500s" value="077 you’re not the only comic book fan in this school."/>
                            <keyword start="1603223/25s" duration="5600/2500s" value="078  i just make it look good."/>
                            <keyword start="1603279/25s" duration="15700/2500s" value="079 jeremiah allows himself a small smile, having enjoyed the brief experience of friendly warmth."/>
                        </mc-clip>
