                            <keyword start="55974s" duration="380300/2500s" value=" sc 3"/>
                            <keyword start="1400427/25s" duration="8000/2500s" value="065 forget everything i’ve taught you this year, my padawans. "/>
                            <keyword start="1400507/25s" duration="11500/2500s" value="066 the best way to actually measure the speed of light is by how fast my tinder dates want to leave. "/>
                            <keyword start="1400607/25s" duration="14000/2500s" value="067 the n/s students love it. hendrix is in his element."/>
                            <keyword start="1401076/25s" duration="7900/2500s" value="065 forget everything i’ve taught you this year, my padawans. "/>
                            <keyword start="280231/5s" duration="13000/2500s" value="066 the best way to actually measure the speed of light is by how fast my tinder dates want to leave. "/>
                            <keyword start="1401267/25s" duration="7000/2500s" value="067 the n/s students love it. hendrix is in his element."/>
                            <keyword start="1401301/25s" duration="9400/2500s" value="068 she arrives at the restaurant, which i have a coupon for by the way, "/>
                            <keyword start="280279/5s" duration="6200/2500s" value="069 she sees me. nek minit - she gone! "/>
                            <keyword start="1401457/25s" duration="5800/2500s" value="071 that’s enough, hendrix. get up."/>
                            <keyword start="280303/5s" duration="8100/2500s" value="073 what do you call this?"/>
                            <keyword start="1401596/25s" duration="8000/2500s" value="074 security, mr muggleton. "/>
                            <keyword start="1401676/25s" duration="10300/2500s" value="075 i was stopping anyone from taking a look and getting an unfair advantage. you’re welcome."/>
                            <keyword start="1401779/25s" duration="4000/2500s" value="077 get out."/>
                            <keyword start="1401819/25s" duration="3000/2500s" value="078 great movie. you seen it?"/>
                            <keyword start="1401849/25s" duration="4800/2500s" value="079 i mean it, hendrix. leave."/>
                            <keyword start="1401897/25s" duration="4100/2500s" value="080 hendrix turns on him, not budging. a stand-off."/>
                            <keyword start="1401938/25s" duration="7700/2500s" value="081 you know, you better hope your dad is happy to bank roll this act of yours forever, "/>
                            <keyword start="1402006/25s" duration="10900/2500s" value="082  because being a spoilt brat is all you’ve got."/>
                            <keyword start="1402083/25s" duration="9100/2500s" value="084 totally humiliated, hendrix is scarily still."/>
                            <keyword start="1402174/25s" duration="7100/2500s" value="085 jeremiah, can you hand these practice exams out please? let’s get started."/>
                            <keyword start="280449/5s" duration="4500/2500s" value="088 i thought i told you to go."/>
                            <keyword start="280458/5s" duration="22000/2500s" value="089 he walks out"/>
                            <keyword start="280502/5s" duration="3600/2500s" value="090 the loud bang makes jeremiah jolt."/>
                            <keyword start="1402546/25s" duration="11300/2500s" value="092 oh no, the ghost got a fright! thought it was supposed to be the other way round. "/>
                            <keyword start="1402659/25s" duration="22400/2500s" value="093 jeremiah doesn’t respond, quietly continues on with his assigned task. "/>
                        </mc-clip>
