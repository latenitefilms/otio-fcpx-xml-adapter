                            <keyword start="1476463/25s" duration="12100/2500s" value="10f - this is serious... my dad won't be happy."/>
                            <keyword start="1476463/25s" duration="161900/2500s" value="- scene 10"/>
                            <keyword start="1476573/25s" duration="17900/2500s" value="10g - have some faith.... clock's ticking..."/>
                            <keyword start="295342/5s" duration="12000/2500s" value="10h - hendrix crosses with an entering mackenzie"/>
                            <keyword start="1476799/25s" duration="6400/2500s" value="10i - mackenzie says &quot;hey&quot;"/>
                            <keyword start="1476846/25s" duration="4200/2500s" value="10j - ritchie says &quot;hi&quot;"/>
                            <keyword start="1476878/25s" duration="3700/2500s" value="10k - mackenzie says &quot;studying?&quot;"/>
                            <keyword start="1476914/25s" duration="2900/2500s" value="10l - ritchie says &quot;yeah&quot;"/>
                            <keyword start="295387/5s" duration="5100/2500s" value="10m - i don’t want to interrupt..."/>
                            <keyword start="1476981/25s" duration="8800/2500s" value="10n - oh, no. i mean, you’re not... did offer to help..."/>
                            <keyword start="1477067/25s" duration="10300/2500s" value="10o - not that i can..."/>
                            <keyword start="295429/5s" duration="17000/2500s" value="10p - is hendrix still on that ridiculous plan to tank your physics exam?"/>
                            <keyword start="1477314/25s" duration="20800/2500s" value="10q - well, a week’s more study would really help."/>
                            <keyword start="1477521/25s" duration="7000/2500s" value="10r - have you agreed to join in?"/>
                            <keyword start="295517/5s" duration="6400/2500s" value="10s - no. not yet, anyway."/>
                            <keyword start="1477648/25s" duration="7400/2500s" value="10t - wow. okay."/>
                            <keyword start="1477721/25s" duration="7900/2500s" value="10u - it’s just stressful. with liv missing..."/>
                            <keyword start="1477792/25s" duration="5600/2500s" value="10v - got it... don't worry about it..."/>
                            <keyword start="1477836/25s" duration="24600/2500s" value="10w - ritchie is left deeply conflicted"/>
                        </mc-clip>
