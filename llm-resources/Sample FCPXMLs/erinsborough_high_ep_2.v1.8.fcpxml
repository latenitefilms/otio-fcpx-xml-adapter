                            <keyword start="1316086/25s" duration="8700/2500s" value="202 yeah, sure. we can invite whoever. "/>
                            <keyword start="1316173/25s" duration="11500/2500s" value="203 there’s still sixteen hours..."/>
                            <keyword start="1316243/25s" duration="5500/2500s" value="204 ritchie’s confused."/>
                            <keyword start="1316298/25s" duration="4600/2500s" value="205 before your physics exam."/>
                            <keyword start="1316344/25s" duration="5700/2500s" value="206 oh. yeah."/>
                            <keyword start="1316401/25s" duration="6800/2500s" value="209 okay, everyone’s on genuine red alert about liv and i’m totally there too.  so let’s find her. "/>
                            <keyword start="1316469/25s" duration="4200/2500s" value="210 what do we know?"/>
                            <keyword start="1316504/25s" duration="4300/2500s" value="211 nothing."/>
                            <keyword start="1316547/25s" duration="5300/2500s" value="212 very helpful. what about you? "/>
                            <keyword start="52664s" duration="3600/2500s" value="214 nothing. why would i?"/>
                            <keyword start="263327/5s" duration="6500/2500s" value="215 duh. because you used to date?"/>
                            <keyword start="1316689/25s" duration="3200/2500s" value="216 mackenzie’s thrown by the news. an agitated ritchie looks awkwardly to mackenzie"/>
                            <keyword start="52668s" duration="11400/2500s" value="217 i’m surprised they haven’t hauled you in for questioning. the ex-boyfriend’s always the number one suspect."/>
                            <keyword start="1316807/25s" duration="5900/2500s" value="218 i’m not a suspect. i don’t know where she is."/>
                            <keyword start="1316862/25s" duration="5500/2500s" value="219 whoa man, chill. i was joking."/>
                            <keyword start="1316917/25s" duration="4600/2500s" value="220 yeah well you’re always just joking."/>
                            <keyword start="1316963/25s" duration="6500/2500s" value="221 that was rude."/>
                            <keyword start="1317021/25s" duration="15100/2500s" value="222 look at ritchie"/>
                        </mc-clip>
