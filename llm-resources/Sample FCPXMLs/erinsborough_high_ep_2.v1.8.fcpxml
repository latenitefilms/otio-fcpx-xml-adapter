                            <keyword start="723754/25s" duration="14600/2500s" value="103 i’ve been impressed by the effort you’ve shown to lift your grades lately. you’re tracking well heading into year twelve."/>
                            <keyword start="28956s" duration="2700/2500s" value="104 tell my dad that."/>
                            <keyword start="723927/25s" duration="4100/2500s" value="105 i did."/>
                            <keyword start="28958s" duration="3900/2500s" value="106 this catches ritchie off guard."/>
                            <keyword start="723968/25s" duration="7200/2500s" value="107 he checks in with your teachers, to make sure you’re focused."/>
                            <keyword start="144808/5s" duration="6000/2500s" value="109 sorry about that"/>
                            <keyword start="28964s" duration="8500/2500s" value="110 i know what it’s like to manage parents and their expectations."/>
                            <keyword start="144837/5s" duration="4000/2500s" value="111 my dad’s not the only one who gives you grief?"/>
                            <keyword start="28969s" duration="8400/2500s" value="112 i was referring to my own. "/>
                            <keyword start="144864/5s" duration="9900/2500s" value="113 (rueful) when i was your age... we did not see eye to eye. it’s hard when you can’t fully be yourself at home."/>
                            <keyword start="145019/5s" duration="13100/2500s" value="103 i’ve been impressed by the effort you’ve shown to lift your grades lately. you’re tracking well heading into year twelve."/>
                            <keyword start="725473/25s" duration="11900/2500s" value="103 i’ve been impressed by the effort you’ve shown to lift your grades lately. you’re tracking well heading into year twelve."/>
                            <keyword start="725592/25s" duration="5600/2500s" value="104 tell my dad that."/>
                            <keyword start="725648/25s" duration="3300/2500s" value="105 i did."/>
                            <keyword start="725668/25s" duration="3500/2500s" value="106 this catches ritchie off guard."/>
                            <keyword start="725683/25s" duration="10200/2500s" value="107 he checks in with your teachers, to make sure you’re focused."/>
                            <keyword start="145157/5s" duration="2800/2500s" value="109 sorry about that"/>
                            <keyword start="725807/25s" duration="8700/2500s" value="110 i know what it’s like to manage parents and their expectations."/>
                            <keyword start="725894/25s" duration="5800/2500s" value="111 my dad’s not the only one who gives you grief?"/>
                            <keyword start="725952/25s" duration="6400/2500s" value="112 i was referring to my own. "/>
                            <keyword start="726016/25s" duration="21700/2500s" value="113 (rueful) when i was your age... we did not see eye to eye. it’s hard when you can’t fully be yourself at home."/>
                            <keyword start="726248/25s" duration="8400/2500s" value="114 it’s not that bad."/>
                            <keyword start="726301/25s" duration="3900/2500s" value="115 cherie studies him, unconvinced"/>
                            <keyword start="726319/25s" duration="20300/2500s" value="116 ritchie’s phone buzzes with texts from mackenzie."/>
                            <keyword start="726522/25s" duration="10400/2500s" value="117 i really should get back to cramming."/>
                            <keyword start="726626/25s" duration="6600/2500s" value="118 don’t suppose any of those are from olivia?"/>
                            <keyword start="726691/25s" duration="5500/2500s" value="119 i heard you guys were close for a while."/>
                            <keyword start="726738/25s" duration="4700/2500s" value="120 no. sorry."/>
                            <keyword start="145357/5s" duration="4800/2500s" value="121 do you still talk?"/>
                            <keyword start="726833/25s" duration="12800/2500s" value="122 sometimes. (awkward) i shouldn’t though. when i talk to girls, it doesn’t end well."/>
                            <keyword start="726961/25s" duration="4100/2500s" value="123 what does that mean?"/>
                            <keyword start="726994/25s" duration="6400/2500s" value="124 nothing. i got to go."/>
                            <keyword start="727058/25s" duration="1600/2500s" value="125 deleted"/>
                            <keyword start="727066/25s" duration="6200/2500s" value="126 thanks. hey... ritchie--"/>
                            <marker start="727094/25s" duration="100/2500s" value="macbook continuity issue in this scene"/>
                            <keyword start="727118/25s" duration="11300/2500s" value="127 cherie look with concern."/>
