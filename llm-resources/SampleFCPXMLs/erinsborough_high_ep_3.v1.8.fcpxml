                            <keyword start="849474/25s" duration="10700/2500s" value="0701 i’ve got almost everyone on board. give me another hour and we’ll be set."/>
                            <keyword start="849474/25s" duration="150200/2500s" value=" sc 7"/>
                            <keyword start="849581/25s" duration="5600/2500s" value="0702 dude, i bet the girls came along easy."/>
                            <keyword start="849637/25s" duration="8000/2500s" value="0703 you know it. all they need is a cheeky compliment."/>
                            <keyword start="849717/25s" duration="5300/2500s" value="0704 the razz master right here."/>
                            <keyword start="169954/5s" duration="5500/2500s" value="0705 ease up."/>
                            <keyword start="33993s" duration="13300/2500s" value="0706 ollie and his gang turn to walk in his direction,"/>
                            <keyword start="849958/25s" duration="12800/2500s" value="0707 look at that - a haunted locker - it’s opened all by itself."/>
                            <keyword start="850086/25s" duration="4300/2500s" value="0708 slam locker"/>
                            <keyword start="850116/25s" duration="7700/2500s" value="0709 almost caught myself a ghost there boys."/>
                            <keyword start="850193/25s" duration="14500/2500s" value="0710 reckon i should put that in my video diary, huh? gonna to be a ghost hunter when i grow up."/>
                            <keyword start="850329/25s" duration="1300/2500s" value="0711 jeremiah tries to move himself away."/>
                            <keyword start="850342/25s" duration="5600/2500s" value="0712 whoa, what’s the hurry?"/>
                            <keyword start="850398/25s" duration="3500/2500s" value="0713 study."/>
                            <keyword start="850433/25s" duration="21300/2500s" value="0715 we got all next year to look forward to. i’ll be doing some haunting of my own."/>
                            <keyword start="850636/25s" duration="3000/2500s" value="0716 jeremiah move"/>
                            <keyword start="850659/25s" duration="1300/2500s" value="0717 boo!"/>
                            <keyword start="170133/5s" duration="3100/2500s" value="0717 boo!"/>
                            <keyword start="850696/25s" duration="28000/2500s" value="0719 jeremiah is left to shakily collect his things,"/>
                        </mc-clip>
