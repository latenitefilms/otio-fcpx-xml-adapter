                            <keyword start="773788/25s" duration="227000/2500s" value=" sc 10"/>
                            <keyword start="774034/25s" duration="6200/2500s" value="131 you admit you gave olivia a lift"/>
                            <keyword start="774096/25s" duration="6900/2500s" value="132 i didn’t want her to be late. she had an exam."/>
                            <keyword start="154833/5s" duration="8400/2500s" value="133 you left school in the middle of the day. what were you even doing there?"/>
                            <keyword start="774249/25s" duration="16400/2500s" value="134 my meals were getting delivered for the week. i told them i wouldn’t be home during the day but they turned up anyway."/>
                            <keyword start="774413/25s" duration="9100/2500s" value="135 those boxes don’t keep them as cool as everyone thinks."/>
                            <keyword start="774504/25s" duration="6300/2500s" value="136 then you just happened to see olivia?"/>
                            <keyword start="774567/25s" duration="3200/2500s" value="137 yes"/>
                            <keyword start="774599/25s" duration="6300/2500s" value="138 what happened after you picked her up"/>
                            <keyword start="774662/25s" duration="8000/2500s" value="139 what do you mean? i drove her to school"/>
                            <keyword start="774734/25s" duration="9600/2500s" value="140 i heard you were late for your own class. "/>
                            <keyword start="154966/5s" duration="8200/2500s" value="141 she didn’t know where her exam was being held. i had to help her"/>
                            <keyword start="774912/25s" duration="8000/2500s" value="142 if you’re trying to imply i acted inappropriately."/>
                            <keyword start="774984/25s" duration="5100/2500s" value="143 you did act inappropriately."/>
                            <keyword start="155006/5s" duration="10700/2500s" value="144 you invited a troubled young student into your car, without parental knowledge or consent."/>
                            <keyword start="775137/25s" duration="6200/2500s" value="145 sure, maybe "/>
                            <keyword start="155037/5s" duration="6100/2500s" value="147 in the car? what did you talk about?"/>
                            <keyword start="775228/25s" duration="10300/2500s" value="146 what did you talk about?"/>
                            <keyword start="775331/25s" duration="8800/2500s" value="148 i don’t know. i had a podcast on. something about the hadron collider."/>
                            <keyword start="775408/25s" duration="8700/2500s" value="149 are you going to tell susan about this? "/>
                            <keyword start="775483/25s" duration="14900/2500s" value="150 yashvi’s already wondering if there’s a relationship. "/>
                            <keyword start="775608/25s" duration="16400/2500s" value="151 you’d seriously think she and i would."/>
                            <keyword start="775731/25s" duration="21900/2500s" value="152 i would never. i swear. "/>
                            <keyword start="775918/25s" duration="10700/2500s" value="153 cherie studies marty"/>
                        </mc-clip>
