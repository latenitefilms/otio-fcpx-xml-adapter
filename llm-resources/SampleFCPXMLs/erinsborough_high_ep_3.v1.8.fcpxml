                            <keyword start="31486s" duration="322400/2500s" value=" sc 10"/>
                            <keyword start="31505s" duration="264600/2500s" value=" sc 10"/>
                            <keyword start="157632/5s" duration="6700/2500s" value="131 you admit you gave olivia a lift"/>
                            <keyword start="788227/25s" duration="7000/2500s" value="132 i didn’t want her to be late. she had an exam."/>
                            <keyword start="788297/25s" duration="9400/2500s" value="133 you left school in the middle of the day. what were you even doing there?"/>
                            <keyword start="788391/25s" duration="19200/2500s" value="134 my meals were getting delivered for the week. i told them i wouldn’t be home during the day but they turned up anyway."/>
                            <keyword start="788583/25s" duration="9400/2500s" value="135 those boxes don’t keep them as cool as everyone thinks."/>
                            <keyword start="788677/25s" duration="5400/2500s" value="136 then you just happened to see olivia?"/>
                            <keyword start="788731/25s" duration="2800/2500s" value="137 yes"/>
                            <keyword start="788748/25s" duration="6600/2500s" value="138 what happened after you picked her up"/>
                            <keyword start="788814/25s" duration="8600/2500s" value="139 what do you mean? i drove her to school"/>
                            <keyword start="31556s" duration="5300/2500s" value="141 she didn’t know where her exam was being held. i had to help her"/>
                            <keyword start="788944/25s" duration="9900/2500s" value="141 she didn’t know where her exam was being held. i had to help her"/>
                            <keyword start="789034/25s" duration="7000/2500s" value="142 if you’re trying to imply i acted inappropriately."/>
                            <keyword start="789104/25s" duration="2s" value="143 you did act inappropriately."/>
                            <keyword start="789154/25s" duration="10700/2500s" value="144 you invited a troubled young student into your car, without parental knowledge or consent."/>
                            <keyword start="789261/25s" duration="7300/2500s" value="145 sure, maybe "/>
                            <keyword start="789322/25s" duration="6200/2500s" value="146 what did you talk about?"/>
                            <keyword start="789356/25s" duration="11000/2500s" value="147 in the car? what did you talk about?"/>
                            <keyword start="789454/25s" duration="8300/2500s" value="148 i don’t know. i had a podcast on. something about the hadron collider."/>
                            <keyword start="789537/25s" duration="9300/2500s" value="149 are you going to tell susan about this? "/>
                            <keyword start="789631/25s" duration="12000/2500s" value="150 yashvi’s already wondering if there’s a relationship. "/>
                            <keyword start="157943/5s" duration="15200/2500s" value="151 you’d seriously think she and i would."/>
                            <keyword start="789841/25s" duration="17400/2500s" value="152 i would never. i swear. "/>
                            <keyword start="790003/25s" duration="22300/2500s" value="153 cherie studies marty"/>
                        </mc-clip>
