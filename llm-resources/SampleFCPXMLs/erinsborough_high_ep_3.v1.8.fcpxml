                            <keyword start="58004s" duration="132s" value=" sc 2"/>
                            <keyword start="1451524/25s" duration="14500/2500s" value="003 restless physics students"/>
                            <keyword start="1451669/25s" duration="6000/2500s" value="004 where’s mugso?"/>
                            <keyword start="1451729/25s" duration="2200/2500s" value="005 he’ll be here."/>
                            <keyword start="1451751/25s" duration="13600/2500s" value="006 mrs. kennedy’s gonna rip him a new one when we all get big fat zeros."/>
                            <keyword start="1451887/25s" duration="6800/2500s" value="007 ritchie’s phone buzzes with a text."/>
                            <keyword start="290391/5s" duration="8500/2500s" value="008 ritchie turns to hendrix,"/>
                            <keyword start="290408/5s" duration="5700/2500s" value="009 i’m out."/>
                            <keyword start="1452097/25s" duration="3000/2500s" value="010 huh?"/>
                            <keyword start="1452127/25s" duration="2800/2500s" value="011 the tank. i’m not doing it."/>
                            <keyword start="1452162/25s" duration="2s" value="012 you can’t pull out now. "/>
                            <keyword start="1452211/25s" duration="4400/2500s" value="013 it’s not going to work if everyone’s not in."/>
                            <keyword start="290451/5s" duration="4000/2500s" value="014 not my problem."/>
                            <keyword start="290459/5s" duration="12100/2500s" value="016 well then - thanks to you - guess i’m going to have to call it off."/>
                            <keyword start="1452416/25s" duration="12000/2500s" value="018 sorry i’m late. you’ll get extra time at the end to compensate."/>
                            <keyword start="1452536/25s" duration="7300/2500s" value="019 everything off your desks except pens, pencils and erasers."/>
                            <keyword start="1452609/25s" duration="6300/2500s" value="020 panicking, hendrix"/>
                            <keyword start="1452672/25s" duration="2600/2500s" value="021 tank’s off."/>
                            <keyword start="1452698/25s" duration="2s" value="022 ritchie whispers the message to"/>
                            <keyword start="1452748/25s" duration="5200/2500s" value="023 students, who pass it on."/>
                            <keyword start="1452763/25s" duration="12400/2500s" value="026 tell ollie."/>
                            <keyword start="1452787/25s" duration="7600/2500s" value="029 enough chatter. i’m about to pass around the exam."/>
                            <keyword start="290577/5s" duration="4300/2500s" value="031 hey ollie..."/>
                            <keyword start="1452928/25s" duration="11400/2500s" value="032 paper ball"/>
                            <keyword start="1453042/25s" duration="10400/2500s" value="035 he shakes his head"/>
                        </mc-clip>
