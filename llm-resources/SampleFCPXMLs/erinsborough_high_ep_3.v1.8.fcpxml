                            <keyword start="1181719/25s" duration="11100/2500s" value="178 there you are. feel like hangin’"/>
                            <keyword start="236366/5s" duration="3600/2500s" value="179 mum wants me straight home."/>
                            <keyword start="1181866/25s" duration="4200/2500s" value="180 i get that. is she angry?"/>
                            <keyword start="1181908/25s" duration="4500/2500s" value="181 she has a lot of questions."/>
                            <keyword start="236388/5s" duration="14400/2500s" value="183 if you ever have stuff you want to talk about..."/>
                            <keyword start="1182084/25s" duration="5600/2500s" value="184 i’m like, the least judgemental person ever."/>
                            <keyword start="236428/5s" duration="4700/2500s" value="185 is this about what you saw on my phone?"/>
                            <keyword start="1182187/25s" duration="8100/2500s" value="186 it’s about everything. i’m worried."/>
                            <keyword start="1182268/25s" duration="9600/2500s" value="187 i shouldn’t have run off on you before. sorry"/>
                            <keyword start="1182364/25s" duration="11100/2500s" value="188 you were upset. and just so you know, i really didn’t look at your messages"/>
                            <keyword start="47299s" duration="6200/2500s" value="192 what are you doing? that’s my locker"/>
                            <keyword start="1182537/25s" duration="5500/2500s" value="193 it’s okay, liv. just wait there"/>
                            <keyword start="1182592/25s" duration="3600/2500s" value="194 you can’t go through my stuff--"/>
                            <keyword start="236523/5s" duration="3400/2500s" value="195 we’re just concerned"/>
                            <keyword start="1182649/25s" duration="2400/2500s" value="197 get out of there!"/>
                            <keyword start="1182673/25s" duration="1s" value="198 unopened pregnancy test falls"/>
                            <keyword start="1182698/25s" duration="3700/2500s" value="200 yashvi, who’s clearly seen, 201 cherie, who has also seen the test"/>
                            <keyword start="236547/5s" duration="7300/2500s" value="199 olivia quickly sweeps it up"/>
                            <keyword start="1182808/25s" duration="6100/2500s" value="202 i think you should come with me"/>
                            <keyword start="1182869/25s" duration="2800/2500s" value="203 i need to get home. "/>
                            <keyword start="1182897/25s" duration="8400/2500s" value="204 we can sort that out once we’ve had a chat."/>
                            <keyword start="1182971/25s" duration="4000/2500s" value="207 do you want me to wait for you?"/>
                            <keyword start="1183011/25s" duration="17800/2500s" value="208 i think it’s best you leave us to it. (light) besides, you’re finished. time to celebrate, right?"/>
                            <keyword start="1183189/25s" duration="23300/2500s" value="209 yashvi looks"/>
                        </mc-clip>
