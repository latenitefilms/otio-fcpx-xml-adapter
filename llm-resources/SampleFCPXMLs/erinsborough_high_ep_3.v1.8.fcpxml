                            <keyword start="1292326/25s" duration="188700/2500s" value=" sc 12"/>
                            <keyword start="1292413/25s" duration="23600/2500s" value="218 hendrix moves along the corridor. jeremiah studying alone inside"/>
                            <marker start="1292581/25s" duration="100/2500s" value="Marker 10"/>
                            <keyword start="1292649/25s" duration="3s" value="219 yo. ghost."/>
                            <keyword start="1292724/25s" duration="6000/2500s" value="220 jeremiah tries to play it cool. i heard about what you did."/>
                            <keyword start="1292784/25s" duration="9000/2500s" value="221 to ollie. you didn’t give him the message."/>
                            <keyword start="1292874/25s" duration="15900/2500s" value="222 didn’t tell his mates either, right? they’re going to hate getting screwed over."/>
                            <keyword start="1293023/25s" duration="12400/2500s" value="223 they deserve it. (dry) guys like that have such a bright future. "/>
                            <keyword start="1293147/25s" duration="12000/2500s" value="224 i mean, we’re talking the leaders of tomorrow here. they need to understand hardship."/>
                            <keyword start="1293273/25s" duration="11400/2500s" value="225 you’re funny. no one mentioned that. "/>
                            <keyword start="1293387/25s" duration="6200/2500s" value="226 guess they don’t take notice"/>
                            <keyword start="1293449/25s" duration="13900/2500s" value="227 they will after tonight. i won five-k at this cup comp and i’m going to chuck some of it on a party at lassiters. room 302."/>
                            <keyword start="1293592/25s" duration="10600/2500s" value="228 it’s going to be a banger. see you there?"/>
                            <keyword start="1293698/25s" duration="7800/2500s" value="229 sure? if you want me to come..."/>
                            <keyword start="1293776/25s" duration="5700/2500s" value="230 i’ll save you some shots. "/>
                            <keyword start="258766/5s" duration="9300/2500s" value="231 wait. what should i wear?"/>
                        </mc-clip>
