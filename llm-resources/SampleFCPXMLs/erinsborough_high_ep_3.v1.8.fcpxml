                            <keyword start="64338s" duration="290300/2500s" value=" sc 3"/>
                            <keyword start="1609573/25s" duration="3500/2500s" value="037 a distracted yashvi opens the door"/>
                            <keyword start="1609608/25s" duration="8700/2500s" value="038 hey, i’m on my way to a foundation meeting. toadie wanted me to pick up a folder?"/>
                            <keyword start="1609688/25s" duration="5400/2500s" value="039 the one on the table?"/>
                            <keyword start="1609742/25s" duration="8500/2500s" value="040 must be it."/>
                            <keyword start="1609827/25s" duration="13100/2500s" value="042 i hear olivia turned up, or rang at least"/>
                            <keyword start="1609958/25s" duration="9100/2500s" value="043 yeah. actually, she was here, earlier. when you came over"/>
                            <keyword start="1610049/25s" duration="7300/2500s" value="044 is she okay?"/>
                            <keyword start="1610122/25s" duration="17200/2500s" value="045 yeah-- no. i’m not sure, but you should know, i don’t think you were the reason she did a runner"/>
                            <keyword start="1610294/25s" duration="9900/2500s" value="046 i shouldn’t have been at the school anyway."/>
                            <keyword start="1610393/25s" duration="2600/2500s" value="048 wait"/>
                            <keyword start="1610419/25s" duration="14400/2500s" value="049 you still remember uni, don’t you? when you were studying teaching?"/>
                            <keyword start="1610563/25s" duration="9500/2500s" value="051 is it ever okay for a student to catch a lift with a teacher?"/>
                            <keyword start="1610658/25s" duration="9000/2500s" value="052 the department of education has pretty strict rules on that sort of thing"/>
                            <keyword start="1610748/25s" duration="10700/2500s" value="053 i know i did bad things, so it feels weird to judge. "/>
                            <keyword start="322171/5s" duration="11100/2500s" value="054 but a teacher shouldn’t blur the lines like that. ever."/>
                            <keyword start="1610966/25s" duration="5500/2500s" value="055 did you see something?"/>
                            <keyword start="1611021/25s" duration="2900/2500s" value="056 i didn’t say that."/>
                            <keyword start="1611044/25s" duration="16400/2500s" value="057 if you did - i think you need to tell susan."/>
                            <keyword start="322222/5s" duration="9800/2500s" value="058 on a torn yashvi"/>
                        </mc-clip>
