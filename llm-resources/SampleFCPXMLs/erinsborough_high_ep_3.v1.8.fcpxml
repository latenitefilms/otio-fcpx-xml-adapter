                            <keyword start="822744/25s" duration="5200/2500s" value="288 mackenzie and ritchie sit"/>
                            <keyword start="32911s" duration="10400/2500s" value="289 &quot;you sure you don’t want to go back inside?&quot;"/>
                            <keyword start="822868/25s" duration="13100/2500s" value="290 &quot;it’s getting kind of messy in there&quot;"/>
                            <keyword start="822934/25s" duration="30600/2500s" value="291 &quot;when you called off the tank...&quot;"/>
                            <keyword start="823207/25s" duration="41700/2500s" value="292 &quot;i don’t know. i guess i kinda hated the idea.&quot;"/>
                            <keyword start="823603/25s" duration="19600/2500s" value="294 why didn’t you say that before?"/>
                            <keyword start="823728/25s" duration="32800/2500s" value="295 &quot;i can’t work you out. sometimes it’s like you...&quot;"/>
                            <keyword start="824043/25s" duration="7s" value="296 &quot;anything you want to know, just ask&quot;"/>
                            <keyword start="824218/25s" duration="10600/2500s" value="297 &quot;...something going on with you &amp; liv?&quot;"/>
                            <keyword start="824324/25s" duration="8800/2500s" value="298 &quot;no. why would you say that?&quot;"/>
                            <keyword start="32976s" duration="8000/2500s" value="299 &quot;you act weird when she comes up&quot;"/>
                            <keyword start="164893/5s" duration="12400/2500s" value="300 &quot;yeah, cos i don't want to talk about it in front...&quot;"/>
                            <keyword start="824583/25s" duration="3000/2500s" value="301 &quot;why not?&quot;"/>
                            <keyword start="824614/25s" duration="7700/2500s" value="302 &quot;because it’s weird&quot;"/>
                            <keyword start="824691/25s" duration="13500/2500s" value="303 &quot;why?&quot;"/>
                            <keyword start="824716/25s" duration="37400/2500s" value="304 &quot;sometimes, i don’t know what to think...&quot;"/>
                            <keyword start="825079/25s" duration="30800/2500s" value="305 &quot;well, maybe i’m not any good at it&quot;"/>
                            <keyword start="825329/25s" duration="32600/2500s" value="306 📱 mackenzie takes out her phone. "/>
