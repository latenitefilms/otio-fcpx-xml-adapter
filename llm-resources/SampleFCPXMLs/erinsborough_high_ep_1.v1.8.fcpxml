                            <note>A: wide - tighter on hendrix/ marty</note>
                            <mc-source angleID="angle2_4169" srcEnable="video">
                                <adjust-transform position="0 -6.41667"/>
                            </mc-source>
                            <keyword start="55422s" duration="623300/2500s" value=" sc 3"/>
                            <keyword start="1388792/25s" duration="14300/2500s" value="059 ritchie, eyes on his phone, enters the chaos"/>
                            <keyword start="277781/5s" duration="3100/2500s" value="060 ritchie walks straight into jeremiah. "/>
                            <keyword start="1388936/25s" duration="5100/2500s" value="061 sorry man. didn’t see you."/>
                            <keyword start="1388987/25s" duration="6000/2500s" value="062 that’s cool. no-one does."/>
                            <keyword start="1389047/25s" duration="4800/2500s" value="063 no response from ritchie as he finds a seat."/>
                            <keyword start="1389084/25s" duration="9400/2500s" value="065 forget everything i’ve taught you this year, my padawans. "/>
                            <keyword start="1389178/25s" duration="15100/2500s" value="066 the best way to actually measure the speed of light is by how fast my tinder dates want to leave. "/>
                            <keyword start="1389329/25s" duration="11900/2500s" value="068 she arrives at the restaurant, which i have a coupon for by the way, "/>
                            <keyword start="1389448/25s" duration="9900/2500s" value="069 she sees me. nek minit - she gone! "/>
                            <keyword start="1389547/25s" duration="6100/2500s" value="071 that’s enough, hendrix. get up."/>
                            <keyword start="1389608/25s" duration="3900/2500s" value="073 what do you call this?"/>
                            <keyword start="1389647/25s" duration="5700/2500s" value="074 security, mr muggleton. "/>
                            <keyword start="1389704/25s" duration="8300/2500s" value="075 i was stopping anyone from taking a look and getting an unfair advantage. you’re welcome."/>
                            <keyword start="1389787/25s" duration="2800/2500s" value="077 get out."/>
                            <keyword start="1389817/25s" duration="4200/2500s" value="078 great movie. you seen it?"/>
                            <keyword start="1389859/25s" duration="6300/2500s" value="079 i mean it, hendrix. leave."/>
                            <keyword start="1389906/25s" duration="4800/2500s" value="080 hendrix turns on him, not budging. a stand-off."/>
                            <keyword start="1389954/25s" duration="8200/2500s" value="081 you know, you better hope your dad is happy to bank roll this act of yours forever, "/>
                            <keyword start="1390036/25s" duration="5900/2500s" value="082  because being a spoilt brat is all you’ve got."/>
                            <keyword start="278019/5s" duration="8500/2500s" value="084 totally humiliated, hendrix is scarily still."/>
                            <keyword start="278036/5s" duration="11000/2500s" value="085 jeremiah, can you hand these practice exams out please? let’s get started."/>
                            <keyword start="278058/5s" duration="3800/2500s" value="088 i thought i told you to go."/>
                            <keyword start="1390328/25s" duration="22800/2500s" value="089 he walks out"/>
                            <keyword start="1390556/25s" duration="3800/2500s" value="090 the loud bang makes jeremiah jolt."/>
                            <keyword start="1390594/25s" duration="10700/2500s" value="092 oh no, the ghost got a fright! thought it was supposed to be the other way round. "/>
                            <keyword start="1390701/25s" duration="26600/2500s" value="093 jeremiah doesn’t respond, quietly continues on with his assigned task. "/>
                        </mc-clip>
