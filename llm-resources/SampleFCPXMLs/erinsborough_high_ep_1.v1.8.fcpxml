                        <mc-clip name="1-2-1-1" offset="37788800/10000s" ref="r125" srcEnable="video" duration="13100/2500s" start="60009s">
                            <note>A: 2 x 3/s mackenzie/yashvi/harlow</note>
                            <mc-source angleID="angle1_763545" srcEnable="video"/>
                            <title name="Grade" lane="1" offset="60009s" ref="r16" duration="360345600/3840000s" start="3600s" role="Grade.Grade-1">
