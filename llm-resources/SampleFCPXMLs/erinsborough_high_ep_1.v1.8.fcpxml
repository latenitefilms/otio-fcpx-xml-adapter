                            <keyword start="1500053/25s" duration="16500/2500s" value="004 that is it, all over."/>
                            <keyword start="1500053/25s" duration="277600/2500s" value=" sc2"/>
                            <keyword start="1500053/25s" duration="9600/2500s" value="003 yashvi emerges"/>
                            <keyword start="1500218/25s" duration="9600/2500s" value="005 i am finally free."/>
                            <keyword start="1500314/25s" duration="8800/2500s" value="009 no need to rub it in. some of us still have exams left. or a whole other year of school."/>
                            <keyword start="1500402/25s" duration="12100/2500s" value="010 yes, boo hoo, this is me, sympathetic, feeling your pain - can i get a high five already?"/>
                            <keyword start="1500523/25s" duration="5500/2500s" value="011 with a wry smile, mackenzie obliges."/>
                            <keyword start="1500578/25s" duration="13200/2500s" value="013 working, paying taxes, voting, university..."/>
                            <keyword start="300142/5s" duration="6600/2500s" value="014 yashvi shifts slightly at the mention of uni. gee mackenzie, way to bring down the vibe. let me enjoy the moment a little."/>
                            <keyword start="1500776/25s" duration="15200/2500s" value="018 enjoy the summer, you know, leave the adulting for next year."/>
                            <keyword start="1500928/25s" duration="11600/2500s" value="023 but my plan is basically, get rich on a game show, spend it on a face and neck tattoo."/>
                            <keyword start="1501044/25s" duration="10600/2500s" value="024 then live out an angry, bitter existence towards all mankind ‘cause i could never get a job."/>
                            <keyword start="60046s" duration="4100/2500s" value="025 solid life plan, don’t you think?"/>
                            <marker start="300232/5s" duration="100/2500s" value="stumble"/>
                            <keyword start="1501186/25s" duration="8300/2500s" value="028 sounds like you’ve got it all figured out."/>
                            <keyword start="1501253/25s" duration="6900/2500s" value="029 okay, who are you sexting?"/>
                            <keyword start="1501322/25s" duration="4200/2500s" value="033 no-one."/>
                            <keyword start="1501364/25s" duration="9200/2500s" value="034 that’s a seriously juicy emoji cocktail."/>
                            <keyword start="1501456/25s" duration="4400/2500s" value="035 is that code for something?"/>
                            <keyword start="60060s" duration="6500/2500s" value="036 mackenzie’s shock sets in as she snatches the phone back, accidentally pressing send at the same time."/>
                            <keyword start="300313/5s" duration="3700/2500s" value="037 i didn’t mean to send that."/>
                            <keyword start="1501602/25s" duration="4700/2500s" value="040 it better not be hendrix."/>
