                            <keyword start="303322/5s" duration="11400/2500s" value="003 yashvi emerges"/>
                            <keyword start="303322/5s" duration="245400/2500s" value=" sc2"/>
                            <keyword start="1516724/25s" duration="6700/2500s" value="004 that is it, all over."/>
                            <keyword start="1516791/25s" duration="9500/2500s" value="005 i am finally free."/>
                            <keyword start="1516886/25s" duration="9200/2500s" value="009 no need to rub it in. some of us still have exams left. or a whole other year of school."/>
                            <keyword start="1516978/25s" duration="11900/2500s" value="010 yes, boo hoo, this is me, sympathetic, feeling your pain - can i get a high five already?"/>
                            <keyword start="1517097/25s" duration="5300/2500s" value="012 well done. time to enjoy the joys of adulthood."/>
                            <keyword start="60686s" duration="15400/2500s" value="013 working, paying taxes, voting, university..."/>
                            <keyword start="1517296/25s" duration="8000/2500s" value="014 yashvi shifts slightly at the mention of uni. gee mackenzie, way to bring down the vibe. let me enjoy the moment a little."/>
                            <keyword start="1517367/25s" duration="10900/2500s" value="018 enjoy the summer, you know, leave the adulting for next year."/>
                            <keyword start="1517476/25s" duration="3100/2500s" value="021 (distracted) ya-huh."/>
                            <keyword start="303501/5s" duration="20700/2500s" value="023 but my plan is basically, get rich on a game show, spend it on a face and neck tattoo."/>
                            <marker start="1517624/25s" duration="100/2500s" value="Marker 6"/>
                            <keyword start="1517712/25s" duration="16800/2500s" value="024 then live out an angry, bitter existence towards all mankind ‘cause i could never get a job."/>
                            <marker start="60711s" duration="100/2500s" value="FUNNY"/>
                            <keyword start="1517841/25s" duration="3900/2500s" value="025 solid life plan, don’t you think?"/>
                            <marker start="1517871/25s" duration="100/2500s" value="Marker 8"/>
                            <keyword start="303576/5s" duration="6100/2500s" value="028 sounds like you’ve got it all figured out."/>
                            <keyword start="1517941/25s" duration="3700/2500s" value="029 okay, who are you sexting?"/>
                            <keyword start="1517978/25s" duration="3900/2500s" value="033 no-one."/>
                            <keyword start="1518017/25s" duration="8800/2500s" value="034 that’s a seriously juicy emoji cocktail."/>
                            <keyword start="303621/5s" duration="4200/2500s" value="035 is that code for something?"/>
                            <keyword start="303626/5s" duration="7700/2500s" value="036 mackenzie’s shock sets in as she snatches the phone back, accidentally pressing send at the same time."/>
                            <keyword start="1518207/25s" duration="3800/2500s" value="037 i didn’t mean to send that."/>
                            <keyword start="303649/5s" duration="4300/2500s" value="040 it better not be hendrix."/>
                            <keyword start="1518288/25s" duration="2700/2500s" value="041 i bet it’s ritchie."/>
                            <keyword start="303663/5s" duration="3200/2500s" value="042 a mild improvement. "/>
                            <keyword start="1518347/25s" duration="3100/2500s" value="043 i’m not sexting. "/>
                            <keyword start="1518378/25s" duration="5200/2500s" value="044 loud enough to be heard by nearby n/s students, further embarrasses her. "/>
                            <keyword start="303686/5s" duration="8400/2500s" value="046 you don’t know where olivia went, do you?"/>
                            <keyword start="1518514/25s" duration="11100/2500s" value="047 in case you can’t tell from - (pointing to her face) - this excitement, i’ve been busy, doing my last exam ever."/>
                            <keyword start="60745s" duration="9900/2500s" value="048 yes, the business exam that liv was meant to be in too. didn’t you notice she wasn’t there?"/>
                            <keyword start="1518724/25s" duration="9900/2500s" value="050 all the teachers have been asking if anyone’s heard from her"/>
                            <keyword start="1518823/25s" duration="4900/2500s" value="049 oh yeah, i didn’t see her. that’s weird."/>
                            <keyword start="1518872/25s" duration="4200/2500s" value="051 apparently she’s missing."/>
                            <keyword start="1518914/25s" duration="8300/2500s" value="052 like, missing missing?"/>
                            <keyword start="1518997/25s" duration="6700/2500s" value="055 come on, it’s been what? a couple of hours? "/>
                            <keyword start="1519091/25s" duration="50600/2500s" value=" sc2"/>
                            <keyword start="1519091/25s" duration="6200/2500s" value="052 like, missing missing?"/>
                            <keyword start="1519152/25s" duration="11400/2500s" value="055 come on, it’s been what? a couple of hours? "/>
                            <keyword start="1519268/25s" duration="7200/2500s" value="056 it’s not like her to miss a year twelve exam though."/>
                            <keyword start="303868/5s" duration="6600/2500s" value="057 love the girl, but we all know liv is a drama queen."/>
                            <keyword start="1519407/25s" duration="19000/2500s" value="058 she’s probably off living out one of her daydreams somewhere."/>
                        </mc-clip>
                        <mc-clip name="1-2-2-1 💚" offset="38268000/10000s" ref="r129" srcEnable="video" duration="6300/2500s" start="152908100/2500s">
