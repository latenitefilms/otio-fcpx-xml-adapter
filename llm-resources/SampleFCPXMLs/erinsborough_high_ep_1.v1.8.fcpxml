                            <keyword start="796346/25s" duration="352300/2500s" value=" sc 8"/>
                            <keyword start="796783/25s" duration="6000/2500s" value="159 cherie finishes up a phone call to susan"/>
                            <keyword start="796839/25s" duration="3700/2500s" value="160 a knock at the door, it’s jeremiah."/>
                            <keyword start="31875s" duration="6200/2500s" value="161 she gestures for him to come in and take a seat. "/>
                            <keyword start="796924/25s" duration="9000/2500s" value="162 i can only imagine what angela’s going through. "/>
                            <keyword start="797001/25s" duration="16800/2500s" value="163 thanks susan. let us know if you hear anything more."/>
                            <keyword start="797168/25s" duration="12100/2500s" value="165  hendrix greyson is the definition of a petulant child."/>
                            <keyword start="797287/25s" duration="2900/2500s" value="169 marty--"/>
                            <keyword start="159462/5s" duration="10700/2500s" value="170 and jesus christ, would it kill these people to give me some real food to eat?"/>
                            <keyword start="159483/5s" duration="4200/2500s" value="171 registers cherie indicating jeremiah’s presence."/>
                            <keyword start="797448/25s" duration="5700/2500s" value="172 mate, i’m sorry. i didn’t know "/>
                            <keyword start="797507/25s" duration="6200/2500s" value="173 that’s cool. teenagers are the worst."/>
                            <keyword start="797564/25s" duration="8900/2500s" value="174 how about we have your careers catch up when things are less hectic, jeremiah? if you don’t mind?"/>
                            <keyword start="797643/25s" duration="5900/2500s" value="175 no worries, miss."/>
                            <keyword start="797701/25s" duration="8200/2500s" value="176 cherie ushers him out and closes the door behind him"/>
                            <keyword start="797779/25s" duration="10400/2500s" value="177 sorry. i had no idea he was here"/>
                            <keyword start="159576/5s" duration="6200/2500s" value="178 you’re lucky it was only jeremiah"/>
                            <keyword start="797947/25s" duration="4s" value="179 and why are you letting yourself get baited by hendrix? you know he tries this on with all of us."/>
                            <keyword start="798039/25s" duration="8700/2500s" value="180 he just pushes my buttons, cherie. every time."/>
                            <keyword start="798122/25s" duration="2s" value="182 did you retaliate?"/>
                            <keyword start="798166/25s" duration="3700/2500s" value="183 marty looks guilty"/>
                            <keyword start="798198/25s" duration="3500/2500s" value="184 marty..."/>
                            <keyword start="798234/25s" duration="9900/2500s" value="185 i know, it was stupid. but i didn’t say anything that wasn’t true. "/>
                            <keyword start="798332/25s" duration="5200/2500s" value="186 you have to apologise"/>
                            <keyword start="798377/25s" duration="3700/2500s" value="187 he started it."/>
                            <keyword start="798417/25s" duration="13500/2500s" value="188 a teenage girl is missing. i think we should be doing everything we can to make the students feel safe. "/>
                            <keyword start="798551/25s" duration="8200/2500s" value="189 despite the effect it might have on our ego. "/>
                            <keyword start="159726/5s" duration="17100/2500s" value="190 marty takes the advice on, but he’s not looking forward to it."/>
                            <keyword start="799383/25s" duration="13200/2500s" value="188 a teenage girl is missing. i think we should be doing everything we can to make the students feel safe. "/>
                            <keyword start="799513/25s" duration="7800/2500s" value="189 despite the effect it might have on our ego. "/>
                            <keyword start="799591/25s" duration="19500/2500s" value="190 marty takes the advice on, but he’s not looking forward to it."/>
                        </mc-clip>
